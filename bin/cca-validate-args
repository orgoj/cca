#!/bin/bash
# Validate and sanitize command arguments to prevent command injection
# Usage: validate-command-args "$ARGUMENTS"
# Returns: Sanitized arguments safe for shell use
# Exit code: 0 = safe, 1 = dangerous

set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: $0 ARGUMENTS" >&2
    exit 1
fi

ARGS="$*"

# Check input length to prevent DoS
if [ ${#ARGS} -gt 4096 ]; then
    echo "ERROR: Arguments too long (max 4096 chars)" >&2
    exit 1
fi

# Check for dangerous patterns
# shellcheck disable=SC2016  # Single quotes intentional for literal patterns
DANGEROUS_PATTERNS=(
    ';'   # Command separator
    '|'   # Pipe
    '&'   # Background/AND
    '$('  # Command substitution
    '`'   # Command substitution (backtick)
    '$'   # Variable expansion ($VAR, ${VAR}, $0-9, ${IFS}, etc.)
    '>'   # Redirect
    '<'   # Redirect
    $'\n' # Newline injection
    $'\r' # Carriage return injection
)

for pattern in "${DANGEROUS_PATTERNS[@]}"; do
    if [[ "$ARGS" == *"$pattern"* ]]; then
        echo "ERROR: Dangerous pattern detected: $pattern" >&2
        echo "Arguments contain shell metacharacters that could enable command injection." >&2
        echo "Blocked for security: $ARGS" >&2
        exit 1
    fi
done

# Check for suspicious strings
if echo "$ARGS" | grep -qE '(rm\s+-rf|mkfs|dd\s+if=|:\(\)|fork|wget.*\||curl.*\|)'; then
    echo "ERROR: Suspicious command pattern detected" >&2
    echo "Blocked for security: $ARGS" >&2
    exit 1
fi

# Arguments are safe - output them
echo "$ARGS"
exit 0
