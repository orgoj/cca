#!/bin/bash

# CCA Installation Script
# Usage: cca-install <command> [args]

set -e

# Get CCA root directory (parent of bin/)
# Resolve symlink to get actual script location
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CCA_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FORCE=false

info() {
    echo -e "${GREEN}ℹ${NC} $1"
}

error() {
    echo -e "${RED}✗${NC} $1" >&2
}

warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Show help
show_help() {
    cat << EOF
CCA Installation Script

Usage: cca-install [options] <command> [args]

Options:
    -f, --force           Force installation (overwrite existing links/files)
    -h, --help            Show this help message

Commands:
    bin <target_dir>      Link all binaries from bin/ to target directory
                          Example: cca-install bin ~/bin

    skills                Link all skills to ./.claude/skills

    skill <skill_name>    Link a specific skill to ./.claude/skills
                          Example: cca-install skill cca-tmux

    help                  Show this help message

Examples:
    cca-install bin ~/bin              # Install binaries to ~/bin
    cca-install -f bin ~/bin           # Install binaries, overwriting existing
    cca-install skills                 # Install all skills locally
    cca-install skill cca-tmux         # Install specific skill locally
EOF
}

# Install binaries
install_bin() {
    local target_dir="$1"

    if [ -z "$target_dir" ]; then
        error "Target directory required"
        echo "Usage: cca-install bin <target_dir>"
        echo "Example: cca-install bin ~/bin"
        exit 1
    fi

    # Expand ~ to home directory
    target_dir="${target_dir/#\~/$HOME}"

    # Create target directory if it doesn't exist
    if [ ! -d "$target_dir" ]; then
        error "Directory not exists: $target_dir"
        exit 1
        # info "Creating directory: $target_dir"
        # mkdir -p "$target_dir"
    fi

    # Get absolute path
    target_dir="$(cd "$target_dir" && pwd)"

    info "Linking binaries to: $target_dir (force=$FORCE)"

    local bin_dir="$CCA_ROOT/bin"
    local count=0

    for script in "$bin_dir"/cca-*; do
        if [ -f "$script" ]; then
            local script_name="$(basename "$script")"
            local target="$target_dir/$script_name"

            # Check existing link/file
            if [ -L "$target" ]; then
                # It's a symlink - check if it points to the right place
                if [ "$(readlink "$target")" = "$script" ]; then
                    info "  ✓ $script_name (already linked)"
                    ((count++)) || true
                    continue
                elif [ "$FORCE" = "true" ]; then
                    rm "$target"
                else
                    warn "  ⚠ $script_name exists but points elsewhere, skipping"
                    continue
                fi
            elif [ -e "$target" ]; then
                if [ "$FORCE" = "true" ]; then
                    rm -rf "$target"
                else
                    warn "  ⚠ $script_name exists as file, skipping"
                    continue
                fi
            fi

            ln -s "$script" "$target"
            info "  ✓ $script_name"
            ((count++)) || true
        fi
    done

    echo ""
    info "Linked $count binaries to $target_dir"

    # Check if target_dir is in PATH
    if [[ ":$PATH:" != *":$target_dir:"* ]]; then
        warn "Make sure $target_dir is in your PATH"
    fi
}

# Link a single skill
link_skill() {
    local skill_dir="$1"
    local target_dir="$2"
    local skill_name="$(basename "$skill_dir")"
    local target="$target_dir/$skill_name"

    # Check existing link/file
    if [ -L "$target" ]; then
        # It's a symlink - check if it points to the right place
        if [ "$(readlink "$target")" = "$skill_dir" ]; then
            info "  ✓ $skill_name (already linked)"
            return 0
        elif [ "$FORCE" = "true" ]; then
            rm "$target"
        else
            warn "  ⚠ $skill_name exists but points elsewhere, skipping"
            return 1
        fi
    elif [ -e "$target" ]; then
        if [ "$FORCE" = "true" ]; then
            rm -rf "$target"
        else
            warn "  ⚠ $skill_name exists as directory/file, skipping"
            return 1
        fi
    fi

    ln -s "$skill_dir" "$target"
    info "  ✓ $skill_name"
    return 0
}

# Install all skills
install_skills() {
    local skills_dir="$PWD/.claude/skills"
    local source_skills_dir="$CCA_ROOT/skills"

    info "Linking all skills from: $source_skills_dir"
    info "Linking skills to: $skills_dir (force=$FORCE)"

    # Create target directory if it doesn't exist
    if [ ! -d "$skills_dir" ]; then
        mkdir -p "$skills_dir"
        info "Created directory: $skills_dir"
    fi

    local count=0

    for skill_dir in "$source_skills_dir"/*; do
        if [ -d "$skill_dir" ]; then
            if link_skill "$skill_dir" "$skills_dir"; then
                ((count++)) || true
            fi
        fi
    done

    echo ""
    info "Linked $count skills to $skills_dir"
}

# Install a specific skill
install_skill() {
    local skill_name="$1"
    local skills_dir="$PWD/.claude/skills"
    local source_skills_dir="$CCA_ROOT/skills"

    if [ -z "$skill_name" ]; then
        error "Skill name required"
        echo "Usage: cca-install skill <skill_name>"
        exit 1
    fi

    local skill_dir="$source_skills_dir/$skill_name"

    if [ ! -d "$skill_dir" ]; then
        # Try with cca- prefix if not found
        if [[ ! "$skill_name" =~ ^cca- ]]; then
             if [ -d "$source_skills_dir/cca-$skill_name" ]; then
                 skill_name="cca-$skill_name"
                 skill_dir="$source_skills_dir/$skill_name"
             fi
        fi
    fi

    if [ ! -d "$skill_dir" ]; then
        error "Skill not found: $skill_name"
        info "Available skills:"
        ls -1 "$source_skills_dir" | sed 's/^/  /'
        exit 1
    fi

    # Create target directory if it doesn't exist
    if [ ! -d "$skills_dir" ]; then
        mkdir -p "$skills_dir"
        info "Created directory: $skills_dir"
    fi

    if link_skill "$skill_dir" "$skills_dir"; then
        info "Skill $skill_name installed to $skills_dir"
    fi
}

# Main script
COMMAND=""
COMMAND_ARGS=()

# Parse options and command
while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--force)
            FORCE=true
            shift
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        bin|skills|skill)
            COMMAND="$1"
            shift
            # Collect remaining arguments for the command
            while [[ $# -gt 0 ]] && [[ ! "$1" =~ ^- ]]; do
                COMMAND_ARGS+=("$1")
                shift
            done
            ;;
        *)
            error "Unknown option: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
done

if [ -z "$COMMAND" ]; then
    show_help
    exit 0
fi

case "$COMMAND" in
    bin)
        install_bin "${COMMAND_ARGS[@]}"
        ;;
    skills)
        install_skills
        ;;
    skill)
        install_skill "${COMMAND_ARGS[@]}"
        ;;
esac
