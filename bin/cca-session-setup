#!/bin/bash
# CCA Plugin Session Setup
# Adds plugin bin/ to PATH at session start

# Debug output (remove after testing)
echo "=== CCA Session Setup Debug ===" >&2
echo "CLAUDE_PLUGIN_ROOT: ${CLAUDE_PLUGIN_ROOT:-NOT_SET}" >&2
echo "CLAUDE_ENV_FILE: ${CLAUDE_ENV_FILE:-NOT_SET}" >&2
echo "PWD: $PWD" >&2

if [ -z "$CLAUDE_ENV_FILE" ]; then
    echo "ERROR: CLAUDE_ENV_FILE not set" >&2
    exit 1
fi

if [ -z "$CLAUDE_PLUGIN_ROOT" ]; then
    echo "ERROR: CLAUDE_PLUGIN_ROOT not set" >&2
    exit 1
fi

PLUGIN_BIN="${CLAUDE_PLUGIN_ROOT}/bin"
echo "Adding to PATH: $PLUGIN_BIN" >&2

echo "export PATH=\"${PLUGIN_BIN}:\$PATH\"" >>"$CLAUDE_ENV_FILE"

echo "Written to $CLAUDE_ENV_FILE:" >&2
cat "$CLAUDE_ENV_FILE" >&2
echo "=== CCA Session Setup Done ===" >&2
