#!/bin/bash

set -e

# Version
VERSION="1.1.0"

# Configuration
LOG_DIR="logs"

# Debug mode flag (set via --debug)
DEBUG_MODE=false

# Check for --debug flag early (before loading .env files)
for arg in "$@"; do
    if [ "$arg" = "--debug" ]; then
        DEBUG_MODE=true
        break
    fi
done

# Debug output function (safe with set -e)
DEBUG() {
    if [ "$DEBUG_MODE" = true ]; then
        echo "DEBUG: $*" >&2
    fi
}

# Load .env file recursively from current dir up to root (only if RUN_ON_CMD not already set)
if [ -z "$RUN_ON_CMD" ]; then
    current_dir="$(pwd)"
    env_found=false

    while [ "$current_dir" != "/" ]; do
        if [ -f "$current_dir/.env" ]; then
            DEBUG "Loading .env from: $current_dir/.env"
            source "$current_dir/.env"
            env_found=true
            break
        fi
        DEBUG "No .env found in: $current_dir"
        current_dir="$(dirname "$current_dir")"
    done

    if [ "$env_found" = false ]; then
        DEBUG "No .env file found in any parent directory"
    fi
    DEBUG "ADMIN_NAME='$ADMIN_NAME', RUN_ON_CMD='$RUN_ON_CMD'"

    # Default to cca-tmux-cli if not found in .env
    RUN_ON_CMD="${RUN_ON_CMD:-cca-tmux-cli}"
fi

# Get script directory for finding cca-tmux-cli (handle symlinks correctly)
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Display unified help information
usage() {
    # Display generic server names (never show real server names)
    local servers_display="server1 server2 server3 ..."

    cat <<EOF
cca-run-on-server - Configurable remote command execution

Usage: cca-run-on-server [OPTIONS] <SERVER> "<COMMAND>"
       cca-run-on-server <SERVER> --create-file <REMOTE_PATH> [LOCAL_FILE]
       cca-run-on-server --list
       cca-run-on-server --help

Options:
  --list                            List available servers
  --help                            Show this help message
  --version                         Show version information
  --debug                           Enable debug output

Arguments:
  SERVER                            Target server name
  COMMAND                           Command to execute on the server

File Creation:
  --create-file REMOTE_PATH [LOCAL_FILE]
    Create a file on the remote server with atomic write (temp file + mv).
    If LOCAL_FILE is provided, its content is used.
    If LOCAL_FILE is omitted, reads content from stdin (heredoc).

Backend Configuration:
  Current backend: $RUN_ON_CMD

  Available backends:
  - cca-tmux-cli    Use cca-tmux-cli for remote execution (default)
  - ssh         Use direct SSH connections

  Configure in .env file:
  RUN_ON_CMD=cca-tmux-cli   # or ssh

Examples:
  cca-run-on-server --list                    # List available servers
  cca-run-on-server server1 "uptime"          # Run command on server
  cca-run-on-server server1 "docker ps"       # Execute docker command

  # Multi-line commands with heredoc work safely:
  cca-run-on-server server1 'cat <<EOF
  line1
  line2
  EOF'

  # Create file from stdin:
  cca-run-on-server server1 --create-file /tmp/test.txt << 'EOF'
  file content here
  EOF

  # Create file from local file:
  cca-run-on-server server1 --create-file /tmp/remote.txt local.txt

Backend-specific behavior:
  cca-tmux-cli: Uses existing tmux sessions with full cca-tmux-cli features
  ssh:      Direct SSH connection with native timeout and error handling

Exit codes:
  - Returns actual exit code of executed commands
  - 64: Usage error (wrong parameters, unknown options)
  - 78: Configuration error (missing configuration)
  - Other codes depend on backend implementation
EOF
}

# Sanitize command for logging (remove sensitive data)
sanitize_command() {
    local cmd="$1"

    # Common patterns for various secret types (based on secrets-patterns-db)

    # 1. URL with credentials: https://user:pass@host
    cmd=$(echo "$cmd" | sed -E 's|(https?://)[^[:space:]@]+:[^[:space:]@]+@|\1[USER]:[REDACTED]@|gi')

    # 2. Key-value patterns: key=value, key:value, key="value", key='value'
    cmd=$(echo "$cmd" | sed -E 's/(password|passwd|token|key|secret|api[_-]?key|access[_-]?key|auth[_-]?key)([[:space:]]*[:=][[:space:]]*)['\''"][^'\''\"]*['\''\"]/\1\2"[REDACTED]"/gi')
    cmd=$(echo "$cmd" | sed -E 's/(password|passwd|token|key|secret|api[_-]?key|access[_-]?key|auth[_-]?key)([[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1\2[REDACTED]/gi')

    # 3. Command line flags: --password value, -p value
    cmd=$(echo "$cmd" | sed -E 's/(^|[[:space:]])(-+)(password|passwd|token|key|secret|api[_-]?key)([[:space:]]+)[^[:space:]]+/\1\2\3\4[REDACTED]/gi')

    # 4. AWS Access Keys: AKIA... pattern
    cmd=$(echo "$cmd" | sed -E 's/AKIA[0-9A-Z]{16}/AKIA[REDACTED]/g')

    # 5. GitHub tokens: ghp_, gho_, ghu_, ghs_, ghr_
    cmd=$(echo "$cmd" | sed -E 's/gh[pous]_[A-Za-z0-9_]{36}/gh*_[REDACTED]/g')

    # 6. JWT tokens (basic pattern)
    cmd=$(echo "$cmd" | sed -E 's/eyJ[A-Za-z0-9_\/+-]*\.[A-Za-z0-9_\/+-]*\.[A-Za-z0-9_\/+-]*/eyJ[JWT_REDACTED]/g')

    # 7. Bearer tokens
    cmd=$(echo "$cmd" | sed -E 's/Bearer[[:space:]]+[A-Za-z0-9_\/\-\.]+/Bearer [REDACTED]/gi')

    # 8. Connection strings: mongodb://, postgres://, mysql://
    cmd=$(echo "$cmd" | sed -E 's|(mongodb|postgres|mysql|mariadb)://[^[:space:]]+|\1://[REDACTED]|gi')

    # 9. Base64 encoded secrets (likely secrets, 40+ chars)
    cmd=$(echo "$cmd" | sed -E 's/[A-Za-z0-9+/]{40,}={0,2}/[BASE64_REDACTED]/g')

    # 10. SSH private key beginnings
    cmd=$(echo "$cmd" | sed 's/-----BEGIN [A-Z ]*PRIVATE KEY-----/-----BEGIN [REDACTED] PRIVATE KEY-----/g')

    # If detect-secrets available, do additional check on remaining command
    if command -v detect-secrets >/dev/null 2>&1; then
        local secrets_output=$(echo "$cmd" | detect-secrets scan --string 2>/dev/null)
        if echo "$secrets_output" | grep -q ": True"; then
            local first_word=$(echo "$cmd" | awk '{print $1}')
            cmd="$first_word [ADDITIONAL SECRETS DETECTED BY detect-secrets]"
        fi
    fi

    echo "$cmd"
}

# Log command execution (unified logging for all backends)
log_command_execution() {
    local target_server="$1"
    local command="$2"
    local exit_code="${3:-0}" # Optional exit code parameter

    DEBUG "log_command_execution called with server='$target_server' command='$command' exit_code='$exit_code'"

    # Skip logging if log directory doesn't exist
    if [ ! -d "$LOG_DIR" ]; then
        DEBUG "$LOG_DIR directory not found, skipping logging"
        return 0
    fi

    DEBUG "$LOG_DIR directory exists"

    # Error if ADMIN_NAME not set when logging is required
    if [ -z "$ADMIN_NAME" ]; then
        DEBUG "ADMIN_NAME is empty, will exit with error"
        echo "Error: ADMIN_NAME not set in .env file" >&2
        echo "Create .env file with: echo 'ADMIN_NAME=your_name' >> .env" >&2
        exit 78
    fi

    DEBUG "ADMIN_NAME='$ADMIN_NAME'"

    local timestamp=$(date -Iseconds)
    local log_date=$(date +%Y-%m-%d)
    local log_file="$LOG_DIR/${log_date}-${ADMIN_NAME}.log"
    local safe_command=$(sanitize_command "$command")

    DEBUG "Writing to log file: $log_file"
    DEBUG "Log entry: $timestamp $ADMIN_NAME ${target_server:-DEFAULT} $safe_command [exit: $exit_code]"

    # Format: TIMESTAMP ADMIN SERVER COMMAND [exit: CODE]
    echo "$timestamp $ADMIN_NAME ${target_server:-DEFAULT} $safe_command [exit: $exit_code]" >>"$log_file"

    DEBUG "Log entry written successfully"
}

# Validate server name against allowed servers
validate_server() {
    local server="$1"

    # Check if server is in TMUX_SESSION_SERVERS list
    if [ -n "$TMUX_SESSION_SERVERS" ]; then
        for allowed_server in $TMUX_SESSION_SERVERS; do
            if [ "$server" = "$allowed_server" ]; then
                return 0
            fi
        done
        echo "Error: Server '$server' not found in allowed servers list" >&2
        echo "Available servers: $TMUX_SESSION_SERVERS" >&2
        exit 2
    else
        echo "Error: TMUX_SESSION_SERVERS not defined in .env file" >&2
        exit 78
    fi
}

# Check backend prerequisites
check_backend() {
    case "$RUN_ON_CMD" in
    "cca-tmux-cli")
        if [ ! -f "$SCRIPT_DIR/cca-tmux-cli" ]; then
            echo "Error: cca-tmux-cli not found but configured as backend" >&2
            exit 78
        fi
        ;;
    "ssh")
        if [ -z "$TMUX_SESSION_SERVERS" ]; then
            echo "Error: TMUX_SESSION_SERVERS not defined in .env for ssh backend" >&2
            exit 78
        fi
        ;;
    *)
        echo "Error: Unknown backend '$RUN_ON_CMD'. Supported: cca-tmux-cli, ssh" >&2
        exit 78
        ;;
    esac
}

# List available servers based on backend
list_servers() {
    check_backend
    case "$RUN_ON_CMD" in
    "cca-tmux-cli")
        exec "$SCRIPT_DIR/cca-tmux-cli" list
        ;;
    "ssh")
        for server in $TMUX_SESSION_SERVERS; do
            echo "$server"
        done
        ;;
    esac
}

# Execute command on server based on backend
execute_command() {
    local server="$1"
    local command="$2"

    check_backend
    case "$RUN_ON_CMD" in
    "cca-tmux-cli")
        exec "$SCRIPT_DIR/cca-tmux-cli" -t "$server" run "$command"
        ;;
    "ssh")
        # Validate server name against allowed servers
        validate_server "$server"

        # Use base64 encoding to safely handle newlines, quotes, heredocs - everything
        # Base64 output contains only safe chars (A-Za-z0-9+/=), decoded and executed via pipe
        local encoded_cmd
        encoded_cmd=$(printf '%s' "$command" | base64 | tr -d '\n')

        # Execute SSH command - decode and pipe to bash
        ssh "$server" "echo '$encoded_cmd' | base64 -d | bash"
        local ssh_exit_code=$?

        # Log the command execution after execution
        log_command_execution "$server" "$command" "$ssh_exit_code"

        # Exit with SSH command's exit code
        exit $ssh_exit_code
        ;;
    esac
}

# Create file on remote server (atomic write via temp file)
# Usage: create_remote_file server remote_path [local_file]
# If local_file is omitted, reads from stdin
create_remote_file() {
    local server="$1"
    local remote_path="$2"
    local local_file="$3" # empty = stdin

    local content
    if [ -n "$local_file" ]; then
        if [ ! -f "$local_file" ]; then
            echo "Error: Local file '$local_file' not found" >&2
            exit 1
        fi
        content=$(cat "$local_file") || exit 1
    else
        content=$(cat) # stdin
    fi

    # Escape remote_path for shell (handles quotes in path)
    local escaped_remote_path
    escaped_remote_path=$(printf %q "$remote_path")

    check_backend
    case "$RUN_ON_CMD" in
    "ssh")
        # Validate server name against allowed servers
        validate_server "$server"

        # SSH: pipe content via stdin, mktemp on remote side for atomic write
        printf '%s' "$content" | ssh "$server" "
            temp_path=\$(mktemp) &&
            cat > \"\$temp_path\" &&
            mv \"\$temp_path\" $escaped_remote_path &&
            ls -ld $escaped_remote_path
        "
        local ssh_exit_code=$?

        # Log the operation
        log_command_execution "$server" "create-file $remote_path" "$ssh_exit_code"

        exit $ssh_exit_code
        ;;
    "cca-tmux-cli")
        # cca-tmux-cli: base64 encode CONTENT (not command!) - this is safe
        local encoded
        encoded=$(printf '%s' "$content" | base64 | tr -d '\n')

        # Execute via cca-tmux-cli (which now uses base64 internally)
        # Note: $encoded is expanded HERE, not on remote - so double quotes are correct
        exec "$SCRIPT_DIR/cca-tmux-cli" -t "$server" run "
            temp_path=\$(mktemp) &&
            echo '$encoded' | base64 -d > \"\$temp_path\" &&
            mv \"\$temp_path\" $escaped_remote_path &&
            ls -ld $escaped_remote_path
        "
        ;;
    esac
}

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
    --list)
        list_servers
        exit 0
        ;;
    --help)
        usage
        exit 0
        ;;
    --version)
        echo "$VERSION"
        exit 0
        ;;
    --debug)
        DEBUG_MODE=true
        shift
        ;;
    -x)
        set -x
        shift
        ;;
    --*)
        echo "Error: Unknown option '$1'" >&2
        usage >&2
        exit 64
        ;;
    *)
        # First non-option argument is the server
        break
        ;;
    esac
done

# Check if server was provided
if [ $# -lt 1 ]; then
    echo "Error: Server required" >&2
    usage >&2
    exit 64
fi

server="$1"
shift

# Check for --create-file mode
if [ "$1" = "--create-file" ]; then
    shift
    if [ $# -lt 1 ]; then
        echo "Error: --create-file requires remote path" >&2
        echo "Usage: cca-run-on-server SERVER --create-file REMOTE_PATH [LOCAL_FILE]" >&2
        exit 64
    fi
    remote_path="$1"
    local_file="${2:-}" # optional local file, empty = stdin
    create_remote_file "$server" "$remote_path" "$local_file"
else
    # Normal command execution mode
    if [ $# -lt 1 ]; then
        echo "Error: Command required" >&2
        usage >&2
        exit 64
    fi
    command="$1"
    execute_command "$server" "$command"
fi
