#!/bin/bash
# Server Status Health Check Script
# Usage: ./cca-server-status SERVER_NAME
# Example: ./cca-server-status server1

set -e

# Get script directory (handle symlinks correctly)
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

if [ $# -eq 0 ]; then
    echo "Usage: $0 <server_name>"
    echo "Example: $0 server1"
    exit 1
fi

SERVER="$1"

echo "<server-status>"
echo "<target>$SERVER</target>"
echo "<admin-time>$(date)</admin-time>"

echo "<hostname>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "hostname"
echo "</hostname>"

echo "<server-time>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "date"
echo "</server-time>"

echo "<cpu>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "lscpu | grep -E 'CPU\\(s\\)|Model name'"
echo "</cpu>"

echo "<load>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "uptime"
echo "</load>"

echo "<memory>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "free -h"
echo "</memory>"

echo "<storage-ext>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "df -hT | grep -E 'ext[2-4]|xfs'" || echo "No ext/xfs filesystems found"
echo "</storage-ext>"

echo "<storage-zfs>"
"$SCRIPT_DIR/cca-run-on-server" "$SERVER" "zpool list 2>/dev/null" || echo "ZFS not available"
echo "</storage-zfs>"

echo "</server-status>"
