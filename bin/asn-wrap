#!/bin/bash

# ASN wrapper script - simple IP lookup with optimized defaults
#
# Usage:
#   asn-wrap IP [IP...]             full JSON (default)
#   asn-wrap -s|--short IP [IP...]  one compact line per IP
#
# Short output (so callers never need to parse JSON themselves):
#   IP | ORG | ASxxxx | CC | dc/proxy/mobile | rep=... | reverse
#
# Multiple IPs are looked up in one call; use -s to compare them at a glance.
# Missing fields render as "-", failed lookups as "LOOKUP <result> (<reason>)".

set -uo pipefail

short=0
case "${1:-}" in
    -s|--short) short=1; shift ;;
    -h|--help)  sed -n '3,14p' "$0"; exit 0 ;;
esac

if ! command -v asn &> /dev/null; then
    echo "Error: 'asn' tool is not installed or not in PATH." >&2
    exit 1
fi

if (( short )) && ! command -v jq &> /dev/null; then
    echo "Error: 'jq' is required for -s/--short but is not installed or not in PATH." >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-s|--short] IP_ADDRESS [IP_ADDRESS...]" >&2
    exit 1
fi

rc=0

for ip in "$@"; do
    if ! out=$(echo "$ip" | asn -n -m -j); then
        echo "$ip | LOOKUP FAILED (asn exit != 0)" >&2
        rc=1
        continue
    fi

    if (( ! short )); then
        printf '%s\n' "$out"
        continue
    fi

    jq -r '
        if (.result // "") != "ok" then
            "\(.target // "?") | LOOKUP \(.result // "?") (\(.reason // "-"))"
        else
            .results[]? |
            [ (.ip // "-"),
              (.org_name // "-"),
              ("AS" + ((.routing.as_number // "?") | tostring)),
              (.geolocation.cc // "-"),
              # NOTE: "//" treats false as empty and would render is_dc=false as "?".
              # tojson keeps true/false/null distinct - false ("not a datacenter") is
              # a real answer, not a missing one, and drives ban decisions.
              ("dc=\(.type.is_dc|tojson) proxy=\(.type.is_proxy|tojson) mobile=\(.type.is_mobile|tojson)"),
              ("rep=" + (.reputation.status // "-")),
              (.["reverse"] // "-")
            ] | join(" | ")
        end
    ' <<<"$out" || rc=1
done

exit $rc
