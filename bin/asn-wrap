#!/bin/bash

# ASN wrapper script - simple IP lookup with optimized defaults
#
# Usage:
#   asn-wrap IP [IP...]             full JSON (default)
#   asn-wrap -s|--short IP [IP...]  one compact line per IP
#
# Short output (so callers never need to parse JSON themselves):
#   IP|ASxxxx|CC|d:true,p:false,m:false|r:reputation|ORG|reverse
#
# Multiple IPs are looked up in one call; use -s to compare them at a glance.
# Missing fields render as "-", failed lookups as "LOOKUP <result> (<reason>)".

set -uo pipefail

short=0
case "${1:-}" in
    -s|--short) short=1; shift ;;
    -h|--help)  sed -n '3,14p' "$0"; exit 0 ;;
esac

if ! command -v asn &> /dev/null; then
    echo "Error: 'asn' tool is not installed or not in PATH." >&2
    exit 1
fi

if (( short )) && ! command -v yq &> /dev/null; then
    echo "Error: 'yq' is required for -s/--short but is not installed or not in PATH." >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: $0 [-s|--short] IP_ADDRESS [IP_ADDRESS...]" >&2
    exit 1
fi

rc=0
err_file=$(mktemp "${TMPDIR:-/tmp}/asn-wrap.XXXXXX") || exit 1
trap 'rm -f "$err_file"' EXIT

for ip in "$@"; do
    if ! out=$(printf '%s\n' "$ip" | asn -n -m -j 2>"$err_file"); then
        cat "$err_file" >&2
        echo "$ip | LOOKUP FAILED (asn exit != 0)" >&2
        rc=1
        continue
    fi

    while IFS= read -r line; do
        case "$line" in
            "jq: parse error:"*) ;;
            *) printf '%s\n' "$line" >&2 ;;
        esac
    done <"$err_file"

    if (( ! short )); then
        printf '%s\n' "$out"
        continue
    fi

    yq -r '
        ((select((.result // "") != "ok") |
            ((.target // "?") + "|LOOKUP:" + (.result // "?") + "|" + (.reason // "-"))),
         (select((.result // "") == "ok") | .results[] |
            [ (.ip // "-"),
              ("AS" + ((.routing.as_number // "?") | to_string)),
              (.geolocation.cc // "-"),
              ("d:" + (.type.is_dc | to_string) +
               ",p:" + (.type.is_proxy | to_string) +
               ",m:" + (.type.is_mobile | to_string)),
              ("r:" + (.reputation.status // "-")),
              (.org_name // "-"),
              (.reverse // "-")
            ] | join("|")))
    ' <<<"$out" || rc=1
done

exit $rc
