#!/usr/bin/env python3
"""
Gather diagnostic data from server without external APIs
Usage: cca-diagnose-gather SERVER [SYMPTOM_KEYWORDS...]

Output: JSON with system state, services, recent commands
"""

from datetime import datetime, timezone
import json
import os
import re
import subprocess
import sys


def validate_server_name(server):
    """Validate server name to prevent command injection"""
    if not re.match(r"^[a-zA-Z0-9_-]+$", server):
        msg = f"Invalid server name: {server}. Only alphanumeric, underscore, and hyphen allowed."
        raise ValueError(msg)
    return server


def run_cmd(cmd_list):
    """Execute command and return output

    Args:
        cmd_list: List of command arguments (NOT shell string)
    """
    try:
        result = subprocess.run(
            cmd_list, check=False, shell=False, capture_output=True, text=True, timeout=30
        )
        return {"success": result.returncode == 0, "stdout": result.stdout, "stderr": result.stderr}
    except subprocess.TimeoutExpired:
        return {"success": False, "error": "Command timeout"}
    except Exception as e:
        return {"success": False, "error": str(e)}


def parse_system_info(output):
    """Parse uptime && free -h && df -h output"""
    lines = output.split("\n")

    # Parse uptime (load average)
    uptime_line = lines[0] if lines else ""
    load_avg = extract_load_average(uptime_line)

    # Parse free -h (memory)
    memory = extract_memory_info(lines)

    # Parse df -h (disk)
    disk = extract_disk_info(lines)

    return {
        "load_average": load_avg,
        "memory": memory,
        "disk": disk,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


def extract_load_average(line):
    """Extract load average from uptime output"""
    # Example: "load average: 1.23, 2.34, 3.45"
    if "load average:" in line:
        try:
            parts = line.split("load average:")[1].strip()
            loads = [float(x.strip()) for x in parts.split(",")]
            return {"1min": loads[0], "5min": loads[1], "15min": loads[2]}
        except (IndexError, ValueError):
            return {}
    return {}


def extract_memory_info(lines):
    """Parse free -h output"""
    # Find "Mem:" line
    for line in lines:
        if line.startswith("Mem:"):
            try:
                parts = line.split()
                return {
                    "total": parts[1],
                    "used": parts[2],
                    "free": parts[3],
                    "available": parts[6] if len(parts) > 6 else "N/A",
                }
            except IndexError:
                return {}
    return {}


def extract_disk_info(lines):
    """Parse df -h output for ZFS and main filesystems"""
    disks = []
    for line in lines:
        # Look for ZFS mounts or main filesystems
        if "/mnt/" in line or "zfs" in line.lower() or line.startswith("/dev/"):
            try:
                parts = line.split()
                if len(parts) >= 6:
                    disks.append(
                        {
                            "filesystem": parts[0],
                            "size": parts[1],
                            "used": parts[2],
                            "avail": parts[3],
                            "use_percent": parts[4],
                            "mountpoint": parts[5],
                        }
                    )
            except IndexError:
                continue
    return disks


def parse_apache_status(output):
    """Parse apache2ctl fullstatus output"""
    # Extract process count, busy workers, etc.
    processes = 0
    busy_workers = 0

    lines = output.split("\n")

    for line in lines:
        # Try to find process count
        if "processes" in line.lower() or "srv" in line:
            processes += 1

        # Try to find busy workers info
        if "busy" in line.lower():
            try:
                # Extract number from line
                words = line.split()
                for word in words:
                    if word.isdigit():
                        busy_workers = int(word)
                        break
            except ValueError:
                pass

    # Simple heuristic: count lines that look like process entries
    process_lines = [
        current_line
        for current_line in lines
        if current_line.strip() and not current_line.startswith("Server") and len(current_line) > 20
    ]
    if process_lines:
        processes = len(process_lines)

    return {
        "processes": processes,
        "busy_workers": busy_workers,
        "status": "running" if output and processes > 0 else "unknown",
        "output_length": len(output),
    }


def parse_docker_ps(output):
    """Parse docker ps output"""
    containers = []
    lines = output.split("\n")

    # Skip header line
    for line in lines[1:]:
        if line.strip():
            try:
                parts = line.split()
                if len(parts) >= 2:
                    # Docker ps format: CONTAINER ID   IMAGE   COMMAND   CREATED   STATUS   PORTS   NAMES
                    containers.append(
                        {
                            "id": parts[0],
                            "image": parts[1] if len(parts) > 1 else "unknown",
                            "status": " ".join(parts[4:-1]) if len(parts) > 5 else "unknown",
                            "name": parts[-1],
                        }
                    )
            except IndexError:
                continue

    return containers


def gather_data(server, symptom_keywords):
    """Main data gathering function"""
    # Validate server name first to prevent command injection
    try:
        validate_server_name(server)
    except ValueError as e:
        return {
            "error": str(e),
            "server": server,
            "timestamp": datetime.now(timezone.utc).isoformat(),
        }

    data = {
        "server": server,
        "symptom": " ".join(symptom_keywords),
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "system": {},
        "services": {},
    }

    # 1. System basics
    print(f"Gathering system state from {server}...", file=sys.stderr)
    result = run_cmd(["cca-run-on-server", server, "uptime && free -h && df -h"])
    if result["success"]:
        data["system"] = parse_system_info(result["stdout"])
    else:
        data["system"]["error"] = result.get("error", result.get("stderr", "Unknown error"))

    # 2. Service status based on keywords
    keywords = [k.lower() for k in symptom_keywords]

    if any(k in ["apache", "php", "web", "http"] for k in keywords):
        print("Gathering Apache status...", file=sys.stderr)
        apache_cmd = os.environ.get("CCA_APACHE_STATUS_CMD", "apache2ctl")
        result = run_cmd(["cca-run-on-server", server, f"{apache_cmd} fullstatus | head -100"])
        if result["success"]:
            data["services"]["apache"] = parse_apache_status(result["stdout"])
        else:
            data["services"]["apache"] = {"error": result.get("error", "Failed to get status")}

    if any(k in ["docker", "container"] for k in keywords):
        print("Gathering Docker status...", file=sys.stderr)
        result = run_cmd(["cca-run-on-server", server, "docker ps"])
        if result["success"]:
            data["services"]["docker"] = parse_docker_ps(result["stdout"])
        else:
            data["services"]["docker"] = {"error": result.get("error", "Failed to get status")}

    if any(k in ["mongodb", "mongo", "db", "database"] for k in keywords):
        mongo_cmd = os.environ.get("CCA_MONGODB_STATUS_CMD")
        if not mongo_cmd:
            data["services"]["mongodb"] = {
                "skipped": "set CCA_MONGODB_STATUS_CMD to the project's MongoDB status command"
            }
        else:
            print("Gathering MongoDB status...", file=sys.stderr)
            result = run_cmd([mongo_cmd])
            if result["success"]:
                data["services"]["mongodb"] = {
                    "status": "checked",
                    "output": result["stdout"][:500],  # First 500 chars
                }
            else:
                data["services"]["mongodb"] = {"error": result.get("error", "Failed to get status")}

    return data


def main():
    if len(sys.argv) < 2:
        print("Usage: cca-diagnose-gather SERVER [SYMPTOM_KEYWORDS...]", file=sys.stderr)
        print("", file=sys.stderr)
        print("Examples:", file=sys.stderr)
        print("  cca-diagnose-gather server1 slow apache", file=sys.stderr)
        print("  cca-diagnose-gather server2 high load", file=sys.stderr)
        sys.exit(1)

    server = sys.argv[1]
    symptom_keywords = sys.argv[2:] if len(sys.argv) > 2 else []

    data = gather_data(server, symptom_keywords)

    # Output as JSON
    print(json.dumps(data, indent=2))


if __name__ == "__main__":
    main()
