#!/bin/bash
# Transparentní curl wrapper s automatickou autentizací

set -euo pipefail

CRED_ID=""
CURL_ARGS=()

if ! command -v sops &> /dev/null; then
    echo "Error: 'sops' is not installed or not in PATH."
    exit 1
fi

if ! command -v yq &> /dev/null; then
    echo "Error: 'yq' is not installed or not in PATH."
    exit 1
fi

# Parse argumenty
while [[ $# -gt 0 ]]; do
    case $1 in
        --cred-id)
            CRED_ID="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $0 [--cred-id ID] [curl-options...] URL"
            echo "Transparent curl wrapper with automatic authentication"
            echo ""
            echo "Options:"
            echo "  --cred-id ID    Use specific credential ID (optional)"
            echo ""
            echo "Available credentials:"
            if [[ -f secrets/curl.secret.yaml ]]; then
                cat secrets/curl.secret.yaml | yq '.credentials | keys | .[]' | sed 's/^/  /'
            fi
            exit 0
            ;;
        *)
            CURL_ARGS+=("$1")
            shift
            ;;
    esac
done

# Auto-detect credential ID z URL
if [[ -z "$CRED_ID" ]]; then
    for arg in "${CURL_ARGS[@]}"; do
        if [[ "$arg" =~ ^https?:// ]]; then
            # Extrahuj hostname
            HOSTNAME=$(echo "$arg" | sed -E 's|^https?://([^/]+).*|\1|')
            # Konvertuj na credential ID
            CRED_ID=$(echo "$HOSTNAME" | tr '[:upper:]' '[:lower:]' | sed 's/[.-]/_/g')
            
            # Zkus najít v YAML, pokud ne, zkus bez subdomény
            if ! sops -d secrets/curl.secret.yaml | yq ".credentials.$CRED_ID" >/dev/null 2>&1; then
                # Zkus bez první části (subdoména)
                FALLBACK_ID=$(echo "$CRED_ID" | sed 's/^[^_]*_//')
                if sops -d secrets/curl.secret.yaml | yq ".credentials.$FALLBACK_ID" >/dev/null 2>&1; then
                    CRED_ID="$FALLBACK_ID"
                fi
            fi
            break
        fi
    done
fi

if [[ -z "$CRED_ID" ]]; then
    echo "Error: Cannot determine credential ID. Use --cred-id or provide URL" >&2
    echo "Available credentials:" >&2
    sops -d secrets/curl.secret.yaml | yq '.credentials | keys | .[]' | sed 's/^/  /' >&2
    exit 1
fi

# Get credentials from SOPS
CREDS=$(sops -d secrets/curl.secret.yaml | yq ".credentials.$CRED_ID")
if [[ "$CREDS" == "null" ]]; then
    echo "Credentials '$CRED_ID' not found. Available:" >&2
    sops -d secrets/curl.secret.yaml | yq '.credentials | keys | .[]' | sed 's/^/  /' >&2
    exit 1
fi

# Get all data from credentials
BEARER=$(echo "$CREDS" | yq '.bearer')
USERNAME=$(echo "$CREDS" | yq '.username')
PASSWORD=$(echo "$CREDS" | yq '.password')
CSRF_REQUIRED=$(echo "$CREDS" | yq '.csrf')

# Build curl config - add everything that's defined
CONFIG=""

# Add bearer
if [[ "$BEARER" != "null" ]]; then
    CONFIG+="header = \"Authorization: Bearer $BEARER\""$'\n'
fi

# Add user/pass
if [[ "$USERNAME" != "null" ]]; then
    CONFIG+="user = \"$USERNAME:$PASSWORD\""$'\n'
fi

# Add CSRF - get token from URL in CURL_ARGS
if [[ "$CSRF_REQUIRED" == "true" ]]; then
    # Extract URL from curl arguments
    for arg in "${CURL_ARGS[@]}"; do
        if [[ "$arg" =~ ^https?:// ]]; then
            BASE_URL="$arg"
            break
        fi
    done

    if [[ -n "$BASE_URL" ]]; then
        # Get CSRF token using existing CONFIG
        HTML_RESPONSE=$(curl -s --config - "$BASE_URL" <<< "$CONFIG")

        # Extract CSRF token from meta tag or hidden input
        CSRF_TOKEN=$(echo "$HTML_RESPONSE" | grep -oP "name=[\"']csrf-token[\"'][^>]*content=[\"']?\K[^\"'>\s]+" || \
                     echo "$HTML_RESPONSE" | grep -oP "name=[\"']_token[\"'][^>]*value=[\"']?\K[^\"'>\s]+" || \
                     echo "$HTML_RESPONSE" | grep -oP "content=[\"']?\K[^\"'>\s]+(?=[^>]*name=[\"']csrf-token[\"'])" || \
                     echo "")

        if [[ -n "$CSRF_TOKEN" ]]; then
            CONFIG+="header = \"X-CSRF-Token: $CSRF_TOKEN\""$'\n'
        fi
    fi
fi

# Execute curl
curl --config - "${CURL_ARGS[@]}" <<EOF
$CONFIG
EOF

# Cleanup
unset BEARER USERNAME PASSWORD CSRF_TOKEN
