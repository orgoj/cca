#!/bin/bash
# Transparent curl wrapper with automatic authentication from a SOPS file
# (secrets/curl.secret.yaml in the current directory).

set -euo pipefail

SECRETS_FILE="secrets/curl.secret.yaml"
CRED_ID=""
CURL_ARGS=()

for tool in sops yq; do
    if ! command -v "$tool" &>/dev/null; then
        echo "Error: '$tool' is not installed or not in PATH." >&2
        exit 1
    fi
done

list_credentials() {
    # Keys stay plaintext in SOPS files, no decryption needed
    yq '.credentials | keys | .[]' "$SECRETS_FILE" | sed 's/^/  /'
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --cred-id)
            CRED_ID="$2"
            shift 2
            ;;
        -h|--help)
            echo "Usage: $0 [--cred-id ID] [curl-options...] URL"
            echo "Transparent curl wrapper with automatic authentication"
            echo ""
            echo "Options:"
            echo "  --cred-id ID    Use specific credential ID (optional)"
            echo ""
            echo "Credential ID defaults to the URL hostname with '.' and '-' as '_',"
            echo "then the same without the first subdomain."
            echo ""
            echo "Available credentials:"
            if [[ -f "$SECRETS_FILE" ]]; then
                list_credentials
            fi
            exit 0
            ;;
        *)
            CURL_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ! -f "$SECRETS_FILE" ]]; then
    echo "Error: $SECRETS_FILE not found in $(pwd)" >&2
    exit 1
fi

# Decrypt once; lookups use strenv() so IDs are never parsed as yq syntax
SECRETS=$(sops -d "$SECRETS_FILE")

has_cred() {
    [[ "$(ID="$1" yq '.credentials | has(strenv(ID))' <<<"$SECRETS")" == "true" ]]
}

cred_field() {
    ID="$CRED_ID" FIELD="$1" yq '.credentials[strenv(ID)][strenv(FIELD)] // ""' <<<"$SECRETS"
}

BASE_URL=""
for arg in "${CURL_ARGS[@]}"; do
    if [[ "$arg" =~ ^https?:// ]]; then
        BASE_URL="$arg"
        break
    fi
done

# Auto-detect credential ID from URL hostname, falling back to no subdomain
if [[ -z "$CRED_ID" && -n "$BASE_URL" ]]; then
    HOSTNAME=$(sed -E 's|^https?://([^/]+).*|\1|' <<<"$BASE_URL")
    CRED_ID=$(tr '[:upper:]' '[:lower:]' <<<"$HOSTNAME" | sed 's/[.-]/_/g')
    if ! has_cred "$CRED_ID"; then
        FALLBACK_ID=$(sed 's/^[^_]*_//' <<<"$CRED_ID")
        if has_cred "$FALLBACK_ID"; then
            CRED_ID="$FALLBACK_ID"
        fi
    fi
fi

if [[ -z "$CRED_ID" ]]; then
    echo "Error: Cannot determine credential ID. Use --cred-id or provide URL" >&2
    echo "Available credentials:" >&2
    list_credentials >&2
    exit 1
fi

if ! has_cred "$CRED_ID"; then
    echo "Credentials '$CRED_ID' not found. Available:" >&2
    list_credentials >&2
    exit 1
fi

BEARER=$(cred_field bearer)
USERNAME=$(cred_field username)
PASSWORD=$(cred_field password)
CSRF_REQUIRED=$(cred_field csrf)

# Quote a value for a curl config file ("..." with \ and " escaped)
config_quote() {
    local value="${1//\\/\\\\}"
    printf '"%s"' "${value//\"/\\\"}"
}

# Build curl config - add everything that's defined
CONFIG=""
if [[ -n "$BEARER" ]]; then
    CONFIG+="header = $(config_quote "Authorization: Bearer $BEARER")"$'\n'
fi
if [[ -n "$USERNAME" ]]; then
    CONFIG+="user = $(config_quote "$USERNAME:$PASSWORD")"$'\n'
fi

# Add CSRF token fetched from the target URL with the same credentials
if [[ "$CSRF_REQUIRED" == "true" && -n "$BASE_URL" ]]; then
    HTML_RESPONSE=$(curl -s --config - "$BASE_URL" <<<"$CONFIG" || true)
    q="[\"']"
    CSRF_TOKEN=""
    for pattern in \
        "s/.*name=${q}csrf-token${q}[^>]*content=${q}?([^\"'> ]+).*/\\1/p" \
        "s/.*name=${q}_token${q}[^>]*value=${q}?([^\"'> ]+).*/\\1/p" \
        "s/.*content=${q}?([^\"'> ]+)${q}?[^>]*name=${q}csrf-token${q}.*/\\1/p"; do
        CSRF_TOKEN=$(sed -nE "$pattern" <<<"$HTML_RESPONSE" | head -n 1)
        [[ -n "$CSRF_TOKEN" ]] && break
    done
    if [[ -n "$CSRF_TOKEN" ]]; then
        CONFIG+="header = $(config_quote "X-CSRF-Token: $CSRF_TOKEN")"$'\n'
    fi
fi

# Substitute {TOKEN} placeholder in arguments (APIs that take the token in the URL path)
# NOTE: this puts the secret on the curl command line, where it is visible in the
# process list. Use it only for APIs that offer no header-based authentication.
if [[ -n "$BEARER" ]]; then
    for i in "${!CURL_ARGS[@]}"; do
        CURL_ARGS[i]="${CURL_ARGS[i]//\{TOKEN\}/$BEARER}"
    done
fi

exec curl --config - "${CURL_ARGS[@]}" <<<"$CONFIG"
