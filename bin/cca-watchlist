#!/usr/bin/env python3
"""
Watchlist management script - manages watchlist.json with proper data parsing and filtering
"""

import argparse
from datetime import datetime, timedelta, timezone
import json
import os
from pathlib import Path
import re
import sys
import traceback
from typing import Any, Dict, List, Optional
import unicodedata

CREATING_COMMANDS = {"add-routine", "add-incident"}


def resolve_watchlist_path(explicit: Optional[str] = None) -> Path:
    """Resolve watchlist.json in the PROJECT the script is called from.

    Never relative to this script: it is installed as a symlink in PATH and shared
    between projects, so a script-relative path reads someone else's data (or none).
    Order: --watchlist / $CCA_WATCHLIST -> ./cca/watchlist.json -> ./watchlist.json
    """
    if explicit:
        return Path(explicit).expanduser()

    env_path = os.environ.get("CCA_WATCHLIST")
    if env_path:
        return Path(env_path).expanduser()

    cwd = Path.cwd()
    for candidate in (cwd / "cca" / "watchlist.json", cwd / "watchlist.json"):
        if candidate.exists():
            return candidate

    # Nothing exists yet: prefer cca/ when the project keeps CCA in a subdir.
    return cwd / "cca" / "watchlist.json" if (cwd / "cca").is_dir() else cwd / "watchlist.json"


class Watchlist:
    """Manages watchlist.json operations"""

    def __init__(self, filepath: Path, debug: bool = False):
        self.filepath = filepath
        self.debug = debug
        if self.debug:
            print(f"[DEBUG] Using watchlist file: {self.filepath}")
            print(f"[DEBUG] File exists: {self.filepath.exists()}")
        self.data = self._load()

    def _load(self) -> Dict[str, Any]:
        """Load watchlist.json or create new if doesn't exist"""
        if self.filepath.exists():
            if self.debug:
                print("[DEBUG] Loading existing watchlist")
            with self.filepath.open() as f:
                data = json.load(f)
                if self.debug:
                    print(f"[DEBUG] Loaded {len(data.get('items', []))} items")
                return data
        else:
            if self.debug:
                print("[DEBUG] Creating new watchlist")
            return {"version": "1.0", "items": []}

    def _save(self):
        """Save watchlist.json"""
        if self.debug:
            print("[DEBUG _save] Starting save")
            print(f"[DEBUG _save] Filepath: {self.filepath}")
            print(f"[DEBUG _save] Filepath type: {type(self.filepath)}")
            print(f"[DEBUG _save] Items to save: {len(self.data.get('items', []))}")
            print(f"[DEBUG _save] Data structure: {list(self.data.keys())}")
        try:
            # Ensure parent directory exists
            parent = self.filepath.parent
            if self.debug:
                print(f"[DEBUG _save] Parent directory: {parent}")
                print(f"[DEBUG _save] Parent exists: {parent.exists()}")

            parent.mkdir(parents=True, exist_ok=True)

            if self.debug:
                print("[DEBUG _save] Parent directory created/verified")
                print(f"[DEBUG _save] Opening file for writing: {self.filepath}")

            with self.filepath.open("w") as f:
                if self.debug:
                    print("[DEBUG _save] File opened successfully")
                json_str = json.dumps(self.data, indent=2)
                if self.debug:
                    print(f"[DEBUG _save] JSON serialized, size: {len(json_str)} bytes")
                    print(f"[DEBUG _save] First 200 chars: {json_str[:200]}")
                f.write(json_str)
                if self.debug:
                    print("[DEBUG _save] JSON written to file")

            if self.debug:
                print("[DEBUG _save] File closed successfully")
                print(f"[DEBUG _save] File exists after save: {self.filepath.exists()}")
                print(
                    f"[DEBUG _save] File size: {self.filepath.stat().st_size if self.filepath.exists() else 'N/A'}"
                )
                print(f"[DEBUG _save] Saved: {self.filepath}")
        except Exception as e:
            print(f"ERROR: Failed to save: {e}")
            if self.debug:
                traceback.print_exc()
            sys.exit(1)

    @staticmethod
    def slugify(name: str) -> str:
        """Convert name to slug format (remove diacritics, lowercase, replace non-alphanumeric with dash)"""
        # Remove diacritics (ě→e, š→s, č→c, etc.)
        slug = unicodedata.normalize("NFKD", name)
        slug = slug.encode("ascii", "ignore").decode("ascii")

        slug = slug.lower()
        slug = re.sub(r"[^a-z0-9]", "-", slug)
        slug = re.sub(r"-+", "-", slug)
        return slug.strip("-")

    @staticmethod
    def parse_check_after(input_str: str) -> Optional[str]:
        """Parse 'YYYY-MM-DD [morning|afternoon]' -> ISO timestamp"""
        if not input_str:
            return None

        match = re.match(r"^(\d{4}-\d{2}-\d{2})\s*(morning|afternoon)?$", input_str)
        if not match:
            return None

        date_str = match.group(1)
        time_part = match.group(2) or "morning"

        if time_part == "morning":
            time_str = "06:00:00"
        elif time_part == "afternoon":
            time_str = "12:00:00"
        else:
            time_str = "06:00:00"

        return f"{date_str}T{time_str}"

    @staticmethod
    def parse_monitor_until(input_str: str) -> Optional[str]:
        """Parse 'X week(s)|day(s)' -> ISO timestamp (from today)"""
        if not input_str:
            return None

        match = re.match(r"^(\d+)\s*(week|day)s?$", input_str)
        if not match:
            return None

        count = int(match.group(1))
        unit = match.group(2)

        today = datetime.now(timezone.utc).date()
        if unit == "week":
            end_date = today + timedelta(days=count * 7)
        else:  # day
            end_date = today + timedelta(days=count)

        return f"{end_date}T00:00:00"

    def list_today(self, item_type: Optional[str] = None) -> List[Dict[str, Any]]:
        """
        List tasks for today
        item_type: 'routine' or 'incident' to filter, None for all
        """
        today_str = datetime.now(timezone.utc).date().isoformat()
        now_iso = datetime.now(timezone.utc).isoformat()

        results = []
        for item in self.data.get("items", []):
            # Check enabled
            if not item.get("enabled", True):
                continue

            # Filter by type
            if item_type == "routine":
                if item.get("type") != "routine":
                    continue
            elif item_type == "incident":
                if item.get("type") != "incident" or item.get("status") != "monitoring":
                    continue
            elif item.get("type") == "incident" and item.get("status") != "monitoring":
                continue

            # Check if needs checking today (not already checked today)
            last_check = item.get("last_check", "never")
            if last_check != "never":
                last_check_date = last_check.split("T")[0]
                if last_check_date >= today_str:
                    continue

            # Check if scheduled (check_after)
            check_after = item.get("check_after")
            if check_after and check_after > now_iso:
                continue

            # Check if still monitoring (monitor_until)
            monitor_until = item.get("monitor_until")
            if monitor_until and monitor_until <= now_iso:
                continue

            results.append(item)

        return results

    def update_timestamp(self, item_id: str, timestamp: Optional[str] = None) -> Dict[str, Any]:
        """Update last_check timestamp for an item, return updated item"""
        timestamp_iso = timestamp if timestamp else datetime.now(timezone.utc).isoformat()
        found_item = None

        for item in self.data.get("items", []):
            if item.get("id") == item_id:
                item["last_check"] = timestamp_iso
                # Auto-disable one-time tasks after first check
                if item.get("once", False):
                    item["enabled"] = False
                found_item = item
                break

        if not found_item:
            print(json.dumps({"error": f"Item '{item_id}' not found"}))
            sys.exit(1)

        self._save()
        return found_item

    def search(self, query: str) -> List[Dict[str, Any]]:
        """Search items by name (case-insensitive substring match)"""
        query_lower = query.lower()
        results = []

        for item in self.data.get("items", []):
            if not item.get("enabled", True):
                continue
            if query_lower in item.get("name", "").lower():
                results.append(item)

        return results

    def add_routine(
        self,
        name: str,
        description: str,
        keywords: Optional[str] = None,
        check_after: Optional[str] = None,
        monitor_until: Optional[str] = None,
        once: bool = False,
    ) -> Dict[str, Any]:
        """Add new routine check, return created item"""
        if self.debug:
            print(
                f"[DEBUG] add_routine called: name={name}, description={description}, keywords={keywords}"
            )

        keywords = keywords or name.lower()
        item_id = self.slugify(name)

        if self.debug:
            print(f"[DEBUG] Generated ID: {item_id}")
            print(f"[DEBUG] Keywords: {keywords}")

        # Parse check_after and monitor_until
        check_after_iso = self.parse_check_after(check_after) if check_after else None
        monitor_until_iso = self.parse_monitor_until(monitor_until) if monitor_until else None

        item = {
            "id": item_id,
            "type": "routine",
            "name": name,
            "description": description,
            "guide_keywords": keywords,
            "last_check": "never",
            "check_after": check_after_iso,
            "monitor_until": monitor_until_iso,
            "once": once,
            "enabled": True,
        }

        if self.debug:
            print(f"[DEBUG] Item object created: {item}")
            print(f"[DEBUG] Current items count before append: {len(self.data.get('items', []))}")

        self.data["items"].append(item)

        if self.debug:
            print(f"[DEBUG] Item appended. Items count after: {len(self.data.get('items', []))}")
            print(f"[DEBUG] Full data before save: {json.dumps(self.data, indent=2)}")

        self._save()
        return item

    def add_incident(
        self,
        name: str,
        file: str,
        status: str,
        risk: str = "MEDIUM",
        description: str = "",
        next_action: str = "Monitor",
        check_after: Optional[str] = None,
        monitor_until: Optional[str] = None,
    ) -> Dict[str, Any]:
        """Add new incident, return created item"""
        # Generate ID: slug + date
        date_part = datetime.now(timezone.utc).strftime("%Y%m%d")
        item_id = f"{self.slugify(name)}-{date_part}"

        # Parse check_after and monitor_until
        check_after_iso = self.parse_check_after(check_after) if check_after else None
        monitor_until_iso = self.parse_monitor_until(monitor_until) if monitor_until else None

        item = {
            "id": item_id,
            "type": "incident",
            "name": name,
            "file": file,
            "status": status,
            "risk": risk,
            "description": description,
            "last_check": "never",
            "check_after": check_after_iso,
            "monitor_until": monitor_until_iso,
            "next_action": next_action,
            "enabled": True,
        }

        self.data["items"].append(item)
        self._save()
        return item

    def remove_item(self, item_id: str) -> Dict[str, Any]:
        """Remove item by ID, return removed item"""
        found_item = None
        new_items = []

        for item in self.data.get("items", []):
            if item.get("id") == item_id:
                found_item = item
            else:
                new_items.append(item)

        if not found_item:
            print(json.dumps({"error": f"Item '{item_id}' not found"}))
            sys.exit(1)

        self.data["items"] = new_items
        self._save()
        return found_item

    def disable_item(self, item_id: str) -> Dict[str, Any]:
        """Disable item by ID (set enabled=false), return updated item"""
        found_item = None

        for item in self.data.get("items", []):
            if item.get("id") == item_id:
                item["enabled"] = False
                found_item = item
                break

        if not found_item:
            print(json.dumps({"error": f"Item '{item_id}' not found"}))
            sys.exit(1)

        self._save()
        return found_item

    def enable_item(self, item_id: str) -> Dict[str, Any]:
        """Enable item by ID (set enabled=true), return updated item"""
        found_item = None

        for item in self.data.get("items", []):
            if item.get("id") == item_id:
                item["enabled"] = True
                found_item = item
                break

        if not found_item:
            print(json.dumps({"error": f"Item '{item_id}' not found"}))
            sys.exit(1)

        self._save()
        return found_item


def format_items(items: List[Dict[str, Any]]):
    """Format items for display"""
    if not items:
        print("No items found")
        return

    for item in items:
        item_type = item.get("type", "unknown")
        name = item.get("name", "unknown")
        item_id = item.get("id", "unknown")

        if item_type == "routine":
            print(f"[ROUTINE] {name}")
            print(f"  ID: {item_id}")
            print(f"  Description: {item.get('description')}")
            print(f"  Keywords: {item.get('guide_keywords')}")
        else:  # incident
            print(f"[INCIDENT] {name}")
            print(f"  ID: {item_id}")
            print(f"  File: {item.get('file')}")
            print(f"  Status: {item.get('status')}")
            print(f"  Risk: {item.get('risk')}")
            print(f"  Description: {item.get('description')}")
            print(f"  Next Action: {item.get('next_action')}")

        print(f"  Last Check: {item.get('last_check')}")
        if item.get("check_after"):
            print(f"  Check After: {item.get('check_after')}")
        if item.get("monitor_until"):
            print(f"  Monitor Until: {item.get('monitor_until')}")
        print()


def main():
    parser = argparse.ArgumentParser(
        description="Watchlist management", formatter_class=argparse.RawDescriptionHelpFormatter
    )

    # Add --debug as global flag BEFORE subparsers
    parser.add_argument("--debug", action="store_true", help="Enable debug mode")
    parser.add_argument(
        "--watchlist",
        help="Path to watchlist.json (default: $CCA_WATCHLIST, ./cca/watchlist.json, ./watchlist.json)",
    )

    subparsers = parser.add_subparsers(dest="command", help="Commands")

    parser.epilog = """
Examples:
  watchlist list-today
  watchlist list-today --type routine
  watchlist list-today --type incident
  watchlist update hetrix-status
  watchlist search server1

  watchlist add-routine \\
    --name "Hetrix status" \\
    --description "Check all server outages and status changes since last check" \\
    --keywords "hetrix monitoring"

  watchlist add-routine \\
    --name "Check example.com sites" \\
    --description "Check example.com domain and related sites" \\
    --keywords "example.com web server1" \\
    --once

  watchlist add-incident \\
    --name "server1 OOM kills" \\
    --file "incidents/2025-10-14-oom-kill-server1-services.md" \\
    --status monitoring \\
    --risk MEDIUM \\
    --description "Memory pressure on server1 - monitor for stability" \\
    --next-action "Monitor 1 week" \\
    --monitor-until "1 week"

  watchlist add-incident \\
    --name "server1 database maintenance" \\
    --file "incidents/2025-10-14-server1-database-maintenance-long-runtime.md" \\
    --status monitoring \\
    --risk LOW \\
    --description "Long-running database maintenance task" \\
    --next-action "Check 2025-10-16 morning" \\
    --check-after "2025-10-16 morning"

  watchlist disable server1-database-maintenance-20251016
  watchlist enable server2-memory-usage
  watchlist remove old-incident-20251001
    """

    # list-today
    list_today_parser = subparsers.add_parser("list-today", help="List tasks to check today")
    list_today_parser.add_argument("--type", choices=["routine", "incident"], help="Filter by type")

    # update
    update_parser = subparsers.add_parser("update", help="Update last_check timestamp")
    update_parser.add_argument("id", help="Item ID")
    update_parser.add_argument("--timestamp", help="ISO timestamp (default: NOW)")

    # search
    search_parser = subparsers.add_parser("search", help="Search items by name")
    search_parser.add_argument("query", help="Search query")

    # add-routine
    add_routine_parser = subparsers.add_parser("add-routine", help="Add routine check")
    add_routine_parser.add_argument("--name", required=True, help="Routine name")
    add_routine_parser.add_argument("--description", required=True, help="Job description")
    add_routine_parser.add_argument(
        "--keywords", help="Guide keywords (optional, defaults to name.lower())"
    )
    add_routine_parser.add_argument(
        "--check-after", dest="check_after", help='Check after: "YYYY-MM-DD [morning|afternoon]"'
    )
    add_routine_parser.add_argument(
        "--monitor-until", dest="monitor_until", help='Monitor until: "X [week|day](s)"'
    )
    add_routine_parser.add_argument(
        "--once", action="store_true", help="One-time task (auto-disable after first check)"
    )

    # add-incident
    add_incident_parser = subparsers.add_parser("add-incident", help="Add incident")
    add_incident_parser.add_argument("--name", required=True, help="Incident name")
    add_incident_parser.add_argument("--file", required=True, help="Incident file path")
    add_incident_parser.add_argument(
        "--status", required=True, help="Status (monitoring/blocked/resolved)"
    )
    add_incident_parser.add_argument(
        "--risk", default="MEDIUM", help="Risk level (default: MEDIUM)"
    )
    add_incident_parser.add_argument("--description", default="", help="Job description (optional)")
    add_incident_parser.add_argument(
        "--next-action",
        dest="next_action",
        default="Monitor",
        help="Next action (default: Monitor)",
    )
    add_incident_parser.add_argument(
        "--check-after", dest="check_after", help='Check after: "YYYY-MM-DD [morning|afternoon]"'
    )
    add_incident_parser.add_argument(
        "--monitor-until", dest="monitor_until", help='Monitor until: "X [week|day](s)"'
    )

    # remove
    remove_parser = subparsers.add_parser("remove", help="Remove item by ID")
    remove_parser.add_argument("id", help="Item ID")

    # disable
    disable_parser = subparsers.add_parser("disable", help="Disable item (set enabled=false)")
    disable_parser.add_argument("id", help="Item ID")

    # enable
    enable_parser = subparsers.add_parser("enable", help="Enable item (set enabled=true)")
    enable_parser.add_argument("id", help="Item ID")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    debug = getattr(args, "debug", False)
    if debug:
        print(f"[DEBUG MAIN] Debug mode enabled: {debug}")
        print(f"[DEBUG MAIN] Command: {args.command}")

    filepath = resolve_watchlist_path(getattr(args, "watchlist", None))
    if not filepath.exists() and args.command not in CREATING_COMMANDS:
        print(
            f"ERROR: watchlist not found: {filepath}\n"
            "Run this from the project root, or set $CCA_WATCHLIST / --watchlist. "
            "An empty result would look like 'nothing to check today'.",
            file=sys.stderr,
        )
        sys.exit(1)

    watchlist = Watchlist(filepath, debug=debug)

    if debug:
        print(f"[DEBUG MAIN] Watchlist created, calling command: {args.command}")

    if args.command == "list-today":
        items = watchlist.list_today(item_type=args.type)
        print(json.dumps(items, indent=2))

    elif args.command == "update":
        item = watchlist.update_timestamp(args.id, timestamp=args.timestamp)
        print(json.dumps(item, indent=2))

    elif args.command == "search":
        items = watchlist.search(args.query)
        print(json.dumps(items, indent=2))

    elif args.command == "add-routine":
        if debug:
            print(
                f"[DEBUG MAIN] add-routine: name={args.name}, description={args.description}, keywords={args.keywords}"
            )
        item = watchlist.add_routine(
            name=args.name,
            description=args.description,
            keywords=args.keywords,
            check_after=args.check_after,
            monitor_until=args.monitor_until,
            once=args.once,
        )
        if debug:
            print("[DEBUG MAIN] add-routine completed")
        print(json.dumps(item, indent=2))

    elif args.command == "add-incident":
        item = watchlist.add_incident(
            name=args.name,
            file=args.file,
            status=args.status,
            risk=args.risk,
            description=args.description,
            next_action=args.next_action,
            check_after=args.check_after,
            monitor_until=args.monitor_until,
        )
        print(json.dumps(item, indent=2))

    elif args.command == "remove":
        item = watchlist.remove_item(args.id)
        print(json.dumps({"removed": item}, indent=2))

    elif args.command == "disable":
        item = watchlist.disable_item(args.id)
        print(json.dumps({"disabled": item}, indent=2))

    elif args.command == "enable":
        item = watchlist.enable_item(args.id)
        print(json.dumps({"enabled": item}, indent=2))


if __name__ == "__main__":
    main()
