#!/usr/bin/env python3
"""Watchlist management - daily checks, backlog, and informational notes.

Schema v2: every item carries a `state`:
  active - takes part in the daily check (`list-today`), subject to check_after/monitor_until
  idle   - backlog: never in `list-today`, but findable via `search` / `list`
  standby - waiting for a described event; excluded from work selections
  done   - finished, kept only for history; hidden unless --all

Notes are idle/done information, never work. Their optional validity boundaries
are inclusive local dates; work scheduling retains its existing UTC semantics.

v1 files (no `state`, `enabled` flag) are NOT read - run `cca-watchlist migrate` once.
"""

import argparse
import json
import os
import re
import stat
import sys
import tempfile
import traceback
import unicodedata
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

if os.name == "nt":
    import msvcrt
else:
    import fcntl

SCHEMA_VERSION = "2.0"
SCHEMA_MAJOR = 2
CREATING_COMMANDS = {"add-routine", "add-incident", "add-task", "add-note"}
ITEM_MUTATION_COMMANDS = (
    "update", "add-routine", "add-note", "add-task", "add-incident",
    "edit", "rename", "park", "activate", "standby", "done",
)
STATES = ("active", "idle", "standby", "done")
TYPES = ("routine", "incident", "task", "note")
EFFORTS = ("e15", "e1h", "e4h", "exl")
CHANGE_RISKS = ("r0", "r1", "r2", "r3")
WINDOWS = ("wany", "woff", "wnight", "wfreeze")
PRIORITIES = ("p1", "p2", "p3")
EFFORT_RANK = {value: rank for rank, value in enumerate(EFFORTS)}
CHANGE_RISK_RANK = {value: rank for rank, value in enumerate(CHANGE_RISKS)}
WINDOW_RANK = {value: rank for rank, value in enumerate(WINDOWS)}
PRIORITY_RANK = {value: rank for rank, value in enumerate(PRIORITIES)}
MINIMUM_WINDOW = {"r0": "wany", "r1": "wany", "r2": "woff", "r3": "wnight"}


def resolve_watchlist_path(explicit: str | None = None) -> Path:
    """Resolve watchlist.json in the PROJECT the script is called from.

    Never relative to this script: it is installed as a symlink in PATH and shared
    between projects, so a script-relative path reads someone else's data (or none).
    Order: --watchlist / $CCA_WATCHLIST -> ./cca/watchlist.json -> ./watchlist.json
    """
    if explicit:
        return Path(explicit).expanduser()

    env_path = os.environ.get("CCA_WATCHLIST")
    if env_path:
        return Path(env_path).expanduser()

    cwd = Path.cwd()
    for candidate in (cwd / "cca" / "watchlist.json", cwd / "watchlist.json"):
        if candidate.exists():
            return candidate

    # Nothing exists yet: prefer cca/ when the project keeps CCA in a subdir.
    return cwd / "cca" / "watchlist.json" if (cwd / "cca").is_dir() else cwd / "watchlist.json"


def die(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    sys.exit(1)


class Watchlist:
    """Manages watchlist.json operations"""

    def __init__(self, filepath: Path, debug: bool = False, allow_legacy: bool = False):
        self.filepath = filepath
        self.debug = debug
        self.allow_legacy = allow_legacy
        if self.debug:
            print(f"[DEBUG] Using watchlist file: {self.filepath}")
            print(f"[DEBUG] File exists: {self.filepath.exists()}")
        self.data = self._load()

    # ------------------------------------------------------------------ IO

    def _load(self) -> dict[str, Any]:
        """Load watchlist.json or create new if it doesn't exist."""
        if not self.filepath.exists():
            if self.debug:
                print("[DEBUG] Creating new watchlist")
            return {"version": SCHEMA_VERSION, "items": []}

        try:
            with self.filepath.open(encoding="utf-8") as f:
                data = json.load(f)
        except json.JSONDecodeError as exc:
            die(f"{self.filepath} is not valid JSON: {exc}")

        if not isinstance(data, dict) or not isinstance(data.get("items"), list):
            die(f"{self.filepath}: expected an object with an 'items' list")

        self._check_version(data)
        if self.debug:
            print(f"[DEBUG] Loaded {len(data['items'])} items")
        return data

    def _check_version(self, data: dict[str, Any]) -> None:
        raw = str(data.get("version", "1.0"))
        try:
            major = int(raw.split(".")[0])
        except ValueError:
            die(f"{self.filepath}: unreadable version {raw!r}")
        if major == SCHEMA_MAJOR or (self.allow_legacy and major == 1):
            return
        if major == 1:
            die(
                f"{self.filepath} is schema v{raw}, this tool needs v{SCHEMA_VERSION}. "
                "Run `cca-watchlist migrate` once to upgrade it."
            )
        die(
            f"{self.filepath} is schema v{raw}, this tool supports schema v{SCHEMA_MAJOR}.x. "
            "Refusing to rewrite an unknown schema version."
        )

    @staticmethod
    def _lock_file(lock) -> None:
        if os.name == "nt":
            lock.seek(0)
            if not lock.read(1):
                lock.write(b"\0")
                lock.flush()
            lock.seek(0)
            msvcrt.locking(lock.fileno(), msvcrt.LK_LOCK, 1)
        else:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)

    @staticmethod
    def _unlock_file(lock) -> None:
        if os.name == "nt":
            lock.seek(0)
            msvcrt.locking(lock.fileno(), msvcrt.LK_UNLCK, 1)
        else:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)

    @contextmanager
    def _locked(self):
        """Serialize read-modify-write against other agents working in the same repo."""
        self.filepath.parent.mkdir(parents=True, exist_ok=True)
        lock_path = self.filepath.with_suffix(self.filepath.suffix + ".lock")
        with lock_path.open("a+b") as lock:
            self._lock_file(lock)
            try:
                # Re-read under the lock: another process may have written meanwhile.
                self.data = self._load()
                yield
            finally:
                self._unlock_file(lock)

    def _save(self):
        """Write atomically: temp file in the same directory, then rename."""
        self.data.setdefault("version", SCHEMA_VERSION)
        payload = json.dumps(self.data, indent=2, ensure_ascii=False) + "\n"
        parent = self.filepath.parent
        parent.mkdir(parents=True, exist_ok=True)
        tmp_fd, tmp_name = tempfile.mkstemp(dir=parent, prefix=".watchlist-", suffix=".tmp")
        try:
            if self.filepath.exists():
                os.chmod(tmp_name, stat.S_IMODE(self.filepath.stat().st_mode))
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(payload)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp_name, self.filepath)
        except Exception as exc:  # original file stays untouched
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            if self.debug:
                traceback.print_exc()
            die(f"failed to save {self.filepath}: {exc}")
        if self.debug:
            print(f"[DEBUG] Saved: {self.filepath} ({len(payload)} bytes)")

    # ------------------------------------------------------------- helpers

    @staticmethod
    def slugify(name: str) -> str:
        """Convert name to slug (strip diacritics, lowercase, non-alnum -> dash)."""
        slug = unicodedata.normalize("NFKD", name)
        slug = slug.encode("ascii", "ignore").decode("ascii")
        slug = slug.lower()
        slug = re.sub(r"[^a-z0-9]", "-", slug)
        slug = re.sub(r"-+", "-", slug)
        return slug.strip("-")

    @staticmethod
    def parse_check_after(input_str: str) -> str | None:
        """Parse an ISO date/time or legacy daypart into a UTC ISO timestamp."""
        if not input_str:
            return None
        match = re.fullmatch(
            r"(\d{4}-\d{2}-\d{2})(?:\s*(morning|afternoon)|T(\d{2}:\d{2}(?::\d{2})?)(Z|[+-]\d{2}:\d{2})?)?",
            input_str,
        )
        if not match:
            return None
        try:
            if match.group(3):
                parsed = datetime.fromisoformat(
                    f"{match.group(1)}T{match.group(3)}{match.group(4) or ''}"
                )
                if parsed.tzinfo is not None:
                    parsed = parsed.astimezone(timezone.utc).replace(tzinfo=None)
            else:
                hour = 12 if match.group(2) == "afternoon" else 6
                parsed = datetime.fromisoformat(f"{match.group(1)}T{hour:02d}:00:00")
        except ValueError:
            return None
        return parsed.isoformat(timespec="seconds")

    @staticmethod
    def parse_monitor_until(input_str: str) -> str | None:
        """Parse 'X week(s)|day(s)' -> ISO timestamp (from today)."""
        if not input_str:
            return None
        match = re.match(r"^(\d+)\s*(week|day)s?$", input_str)
        if not match:
            return None
        count = int(match.group(1))
        today = datetime.now(timezone.utc).date()
        days = count * 7 if match.group(2) == "week" else count
        return f"{today + timedelta(days=days)}T00:00:00"

    def _parse_schedule(self, check_after: str | None, monitor_until: str | None):
        """Parse both schedule inputs, refusing silently-ignored garbage."""
        check_after_iso = None
        monitor_until_iso = None
        if check_after:
            check_after_iso = self.parse_check_after(check_after)
            if not check_after_iso:
                die(
                    f"unparseable --check-after {check_after!r} "
                    "(expected YYYY-MM-DD or YYYY-MM-DDTHH:MM[:SS][Z|±HH:MM]; "
                    "morning/afternoon also accepted)"
                )
        if monitor_until:
            monitor_until_iso = self.parse_monitor_until(monitor_until)
            if not monitor_until_iso:
                die(f"unparseable --monitor-until {monitor_until!r} (expected 'X week(s)|day(s)')")
        return check_after_iso, monitor_until_iso

    def _find(self, item_id: str) -> dict[str, Any]:
        for item in self.data["items"]:
            if item.get("id") == item_id:
                return item
        die(f"item {item_id!r} not found")

    def _project_root(self) -> Path:
        """Project root = parent of cca/, so refs can be written repo-relative."""
        parent = self.filepath.parent
        return parent.parent if parent.name == "cca" else parent

    def _ref_search_bases(self) -> list[Path]:
        """Directories holding incidents/, guides/ and deniky/."""
        parent = self.filepath.parent
        bases = [parent]
        if parent.name != "cca" and (parent / "cca").is_dir():
            bases.append(parent / "cca")
        return bases

    def _ref_exists(self, ref: str) -> bool:
        """A ref with a path is repo-relative; a bare filename is looked up
        in the standard locations, so incidents can be referenced by name only."""
        if "/" in ref:
            return (self._project_root() / ref).exists()
        for base in self._ref_search_bases():
            if (base / "incidents" / ref).exists() or (base / "deniky" / ref).exists():
                return True
            if any(base.glob(f"incidents/archive/*/{ref}")):
                return True
            if any(base.glob(f"guides/**/{ref}")):
                return True
        return False

    def _normalize_existing_ref(self, ref: str) -> str | None:
        """Return an existing ref relative to the project root."""
        root = self._project_root()
        path = Path(ref).expanduser()
        candidates = [path] if path.is_absolute() else [root / path]
        if not path.is_absolute():
            candidates.extend(base / path for base in self._ref_search_bases())
        for candidate in candidates:
            if not candidate.exists():
                continue
            try:
                return candidate.relative_to(root).as_posix()
            except ValueError:
                continue
        return None

    def _warn_missing_refs(self, refs: list[str]) -> None:
        for ref in refs:
            if not self._ref_exists(ref):
                print(f"WARNING: ref not found on disk: {ref}", file=sys.stderr)

    def _validate_state(self, item: dict[str, Any]) -> None:
        state = item.get("state")
        if state not in STATES:
            die(f"state must be one of {', '.join(STATES)}")
        if item.get("type") == "note":
            if state not in ("idle", "done"):
                die("notes must be idle or done; they are information, not daily work")
            for field in (
                "next_action",
                "effort",
                "change_risk",
                "window",
                "blocked_on",
                "check_after",
                "monitor_until",
                "once",
                "last_check",
            ):
                if field in item:
                    die(f"notes cannot have {field}")
            for field in ("valid_from", "valid_until"):
                value = item.get(field)
                if value is not None:
                    try:
                        if not isinstance(value, str) or not re.fullmatch(
                            r"\d{4}-\d{2}-\d{2}", value
                        ):
                            raise ValueError
                        datetime.strptime(value, "%Y-%m-%d")
                    except ValueError:
                        die(f"{field} must be YYYY-MM-DD")
            if (
                item.get("valid_from")
                and item.get("valid_until")
                and item["valid_from"] > item["valid_until"]
            ):
                die("valid_from must not be after valid_until")
        elif item.get("valid_from") is not None or item.get("valid_until") is not None:
            die("valid_from and valid_until are only supported for notes")
        if state == "idle" and item.get("type") != "note" and not item.get("refs"):
            die(
                "an idle item needs at least one --refs entry "
                "(the full context belongs in an incident or guide, not in the register)"
            )

    @staticmethod
    def effective_window(item: dict[str, Any]) -> str | None:
        """Return the stricter of the operational window and the risk minimum."""
        window = item.get("window")
        minimum = MINIMUM_WINDOW.get(item.get("change_risk"))
        if window is None:
            return minimum
        if minimum is None:
            return window
        return max((window, minimum), key=WINDOW_RANK.__getitem__)

    @staticmethod
    def _lift_window_to_minimum(item: dict[str, Any]) -> None:
        """Raise an explicit window to the change_risk minimum instead of refusing it."""
        window = item.get("window")
        minimum = MINIMUM_WINDOW.get(item.get("change_risk"))
        if window and minimum and WINDOW_RANK[window] < WINDOW_RANK[minimum]:
            item["window"] = minimum
            print(
                f"NOTE: window {window} raised to {minimum}, the minimum "
                f"for change_risk {item['change_risk']}",
                file=sys.stderr,
            )

    def _validate_tags(self, item: dict[str, Any]) -> None:
        for field, allowed in (
            ("effort", EFFORTS),
            ("change_risk", CHANGE_RISKS),
            ("window", WINDOWS),
            ("prio", PRIORITIES),
        ):
            value = item.get(field)
            if value is not None and value not in allowed:
                die(f"{field} must be one of {', '.join(allowed)}")

    # -------------------------------------------------------------- queries

    def list_today(self, item_type: str | None = None) -> list[dict[str, Any]]:
        """List items due for a check today (state=active only)."""
        today_str = datetime.now(timezone.utc).date().isoformat()
        now_iso = datetime.now(timezone.utc).isoformat()

        results = []
        for item in self.data["items"]:
            if item.get("state") != "active" or item.get("type") == "note":
                continue

            if item_type and item.get("type") != item_type:
                continue
            if item.get("type") == "incident" and item.get("status") != "monitoring":
                continue

            last_check = item.get("last_check", "never")
            if last_check != "never" and last_check.split("T")[0] >= today_str:
                continue

            check_after = item.get("check_after")
            if check_after and check_after > now_iso:
                continue

            monitor_until = item.get("monitor_until")
            if monitor_until and monitor_until <= now_iso:
                continue

            results.append(item)

        return sorted(results, key=lambda item: (
            item.get("check_after") is None,
            item.get("check_after") or "",
            PRIORITY_RANK.get(item.get("prio"), len(PRIORITY_RANK)),
            item.get("id", ""),
        ))

    def list_items(
        self,
        area: str | None = None,
        state: str | None = None,
        item_type: str | None = None,
        include_done: bool = False,
        effort: str | None = None,
        change_risk: str | None = None,
        window: str | None = None,
        prio: str | None = None,
        max_change_risk: str | None = None,
        expired: bool = False,
        current: bool = False,
    ) -> list[dict[str, Any]]:
        results = []
        today = datetime.now().date().isoformat()
        for item in self.data["items"]:
            if expired or current:
                if item.get("type") != "note":
                    continue
                start, end = item.get("valid_from"), item.get("valid_until")
                if expired and (not end or end >= today):
                    continue
                if current and ((start and start > today) or (end and end < today)):
                    continue
            if state and item.get("state") != state:
                continue
            if not state and not include_done and item.get("state") == "done":
                continue
            if area and item.get("area", "") != area:
                continue
            if item_type and item.get("type") != item_type:
                continue
            if effort and item.get("effort") != effort:
                continue
            if change_risk and item.get("change_risk") != change_risk:
                continue
            if window and item.get("window") != window:
                continue
            if prio and item.get("prio") != prio:
                continue
            if max_change_risk and (
                item.get("change_risk") not in CHANGE_RISK_RANK
                or CHANGE_RISK_RANK[item["change_risk"]] > CHANGE_RISK_RANK[max_change_risk]
            ):
                continue
            results.append(item)
        return sorted(results, key=lambda i: (i.get("area") or "~", i.get("id", "")))

    def ready_items(
        self,
        time_box: str,
        window: str,
        max_change_risk: str | None,
        area: str | None = None,
        include_blocked: bool = False,
    ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
        """Select open items whose current next action can be performed now."""
        ready = []
        untagged = []
        for item in self.data["items"]:
            if (
                item.get("type") == "note"
                or item.get("state") in ("standby", "done")
                or (area and item.get("area", "") != area)
            ):
                continue
            if not include_blocked and item.get("blocked_on", ""):
                continue
            effort = item.get("effort")
            if effort is None:
                untagged.append(item)
                continue
            effective_window = self.effective_window(item)
            change_risk = item.get("change_risk")
            if (
                effort not in EFFORT_RANK
                or effort == "exl"
                or EFFORT_RANK[effort] > EFFORT_RANK[time_box]
                or effective_window not in WINDOW_RANK
                or WINDOW_RANK[effective_window] > WINDOW_RANK[window]
                or (
                    max_change_risk is not None
                    and (
                        change_risk not in CHANGE_RISK_RANK
                        or CHANGE_RISK_RANK[change_risk] > CHANGE_RISK_RANK[max_change_risk]
                    )
                )
            ):
                continue
            ready.append(item)
        ready.sort(
            key=lambda item: (
                PRIORITY_RANK.get(item.get("prio"), len(PRIORITY_RANK)),
                EFFORT_RANK[item["effort"]],
                item.get("id", ""),
            )
        )
        return ready, untagged

    def next_item(self, time_box="e1h", window="wany", max_change_risk=None, area=None):
        """Pick one unblocked action by priority, effort, then ID (read-only)."""
        return next(iter(self.actionable_items(time_box, window, max_change_risk, area)), None)

    def actionable_items(self, time_box="e1h", window="wany", max_change_risk=None, area=None):
        """Return ready items with an action due now, in ready order."""
        items, _ = self.ready_items(time_box, window, max_change_risk, area)
        now = datetime.now(timezone.utc)
        actionable = []
        for item in items:
            if not (item.get("next_action") or "").strip():
                continue
            if item.get("check_after"):
                try:
                    after = datetime.fromisoformat(item["check_after"])
                    if after.tzinfo is None:
                        after = after.replace(tzinfo=timezone.utc)
                except (ValueError, TypeError):
                    continue
                if after > now:
                    continue
            actionable.append(item)
        return actionable

    def agenda(self) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
        """Daily checks first, then other actionable p1 work."""
        today = self.list_today()
        today_ids = {item["id"] for item in today}
        priority = [item for item in self.actionable_items()
                    if item.get("prio") == "p1" and item["id"] not in today_ids]
        return today, priority

    def search(
        self, query: str, include_done: bool = False, state: str | None = None,
        deep: bool = False,
    ) -> list[dict[str, Any]]:
        """Find items containing every query word, ordered by matching field."""
        words = query.casefold().split()
        if not words:
            return []
        field_groups = (
            ("id", "name", "guide_keywords"),
            ("description", "next_action"),
            ("area", "blocked_on", "file"),
        )
        ranked = []
        for item in self.data["items"]:
            if state and item.get("state") != state:
                continue
            if not state and not include_done and item.get("state") == "done":
                continue
            values = [
                [str(item.get(field) or "").casefold() for field in fields]
                for fields in field_groups
            ]
            if deep:
                values.append([str(ref).casefold() for ref in item.get("refs", [])])
            ranks = [
                next((rank for rank, group in enumerate(values)
                      if any(word in value for value in group)), None)
                for word in words
            ]
            if all(rank is not None for rank in ranks):
                ranked.append(((max(ranks), sum(ranks)), item))
        ranked.sort(key=lambda pair: pair[0])
        return [item for _, item in ranked]

    # ------------------------------------------------------------ mutations

    def add_note(
        self,
        name,
        description,
        valid_from=None,
        valid_until=None,
        area="",
        refs=None,
        keywords=None,
        prio="p2",
    ):
        return self._add(
            {
                "id": self.slugify(name),
                "type": "note",
                "state": "idle",
                "name": name,
                "description": description,
                "area": area,
                "refs": list(refs or []),
                "guide_keywords": keywords or name.lower(),
                "prio": prio,
                "valid_from": valid_from,
                "valid_until": valid_until,
            }
        )

    def _add(self, item: dict[str, Any]) -> dict[str, Any]:
        with self._locked():
            if any(existing.get("id") == item["id"] for existing in self.data["items"]):
                die(f"item {item['id']!r} already exists (use `edit` or pick another name)")
            self._validate_state(item)
            self._validate_tags(item)
            self._lift_window_to_minimum(item)
            self._warn_missing_refs(item.get("refs", []))
            self.data["items"].append(item)
            self._save()
        return item

    def _base_item(
        self,
        item_id: str,
        item_type: str,
        name: str,
        description: str,
        area: str,
        state: str,
        refs: list[str],
        blocked_on: str,
        next_action: str,
        keywords: str,
        check_after: str | None,
        monitor_until: str | None,
        once: bool,
        effort: str | None,
        change_risk: str | None,
        window: str | None,
        prio: str | None,
    ) -> dict[str, Any]:
        return {
            "id": item_id,
            "type": item_type,
            "name": name,
            "area": area,
            "state": state,
            "description": description,
            "refs": refs,
            "blocked_on": blocked_on,
            "next_action": next_action,
            "guide_keywords": keywords,
            "last_check": "never",
            "check_after": check_after,
            "monitor_until": monitor_until,
            "once": once,
            "effort": effort,
            "change_risk": change_risk,
            "window": window,
            "prio": prio,
        }

    def add_routine(
        self,
        name,
        description,
        keywords=None,
        area="",
        state="active",
        refs=None,
        blocked_on="",
        next_action="",
        check_after=None,
        monitor_until=None,
        once=False,
        effort=None,
        change_risk=None,
        window=None,
        prio=None,
    ) -> dict[str, Any]:
        check_after_iso, monitor_until_iso = self._parse_schedule(check_after, monitor_until)
        item = self._base_item(
            self.slugify(name),
            "routine",
            name,
            description,
            area,
            state,
            list(refs or []),
            blocked_on,
            next_action,
            keywords or name.lower(),
            check_after_iso,
            monitor_until_iso,
            once,
            effort,
            change_risk,
            window,
            prio,
        )
        return self._add(item)

    def add_task(
        self,
        name,
        description,
        area="",
        state="idle",
        refs=None,
        blocked_on="",
        next_action="",
        keywords=None,
        check_after=None,
        monitor_until=None,
        effort=None,
        change_risk=None,
        window=None,
        prio=None,
    ) -> dict[str, Any]:
        check_after_iso, monitor_until_iso = self._parse_schedule(check_after, monitor_until)
        item = self._base_item(
            self.slugify(name),
            "task",
            name,
            description,
            area,
            state,
            list(refs or []),
            blocked_on,
            next_action,
            keywords or name.lower(),
            check_after_iso,
            monitor_until_iso,
            False,
            effort,
            change_risk,
            window,
            prio,
        )
        return self._add(item)

    def add_incident(
        self,
        name,
        file,
        status,
        risk="MEDIUM",
        description="",
        area="",
        state="active",
        refs=None,
        blocked_on="",
        next_action="Monitor",
        keywords=None,
        check_after=None,
        monitor_until=None,
        effort=None,
        change_risk=None,
        window=None,
        prio=None,
    ) -> dict[str, Any]:
        check_after_iso, monitor_until_iso = self._parse_schedule(check_after, monitor_until)
        date_part = datetime.now(timezone.utc).strftime("%Y%m%d")
        normalized_file = self._normalize_existing_ref(file)
        if normalized_file is None:
            die(f"ref not found on disk: {file}")
        refs = [normalized_file if ref == file else ref for ref in (refs or [])]
        if normalized_file not in refs:
            refs.insert(0, normalized_file)
        item = self._base_item(
            f"{self.slugify(name)}-{date_part}",
            "incident",
            name,
            description,
            area,
            state,
            refs,
            blocked_on,
            next_action,
            keywords or name.lower(),
            check_after_iso,
            monitor_until_iso,
            False,
            effort,
            change_risk,
            window,
            prio,
        )
        item["file"] = normalized_file
        item["status"] = status
        item["risk"] = risk
        return self._add(item)

    def update_timestamp(self, item_id: str, timestamp: str | None = None) -> dict[str, Any]:
        stamp = timestamp if timestamp else datetime.now(timezone.utc).isoformat()
        with self._locked():
            item = self._find(item_id)
            if item.get("type") == "note":
                die("notes have no last_check; use edit or done")
            item["last_check"] = stamp
            if item.get("once", False):
                item["state"] = "done"
            self._save()
        return item

    def set_state(
        self,
        item_id: str,
        state: str,
        blocked_on: str | None = None,
        check_after: str | None = None,
    ) -> dict[str, Any]:
        check_after_iso, _ = self._parse_schedule(check_after, None)
        with self._locked():
            item = self._find(item_id)
            item["state"] = state
            if blocked_on is not None:
                item["blocked_on"] = blocked_on
            if check_after_iso:
                item["check_after"] = check_after_iso
            self._validate_state(item)
            self._validate_tags(item)
            self._lift_window_to_minimum(item)
            self._save()
        return item

    def edit(
        self,
        item_id: str,
        changes: dict[str, Any],
        add_ref: list[str] | None = None,
        remove_ref: list[str] | None = None,
    ) -> dict[str, Any]:
        if not changes and not add_ref and not remove_ref:
            die("edit needs at least one field to change")
        with self._locked():
            item = self._find(item_id)
            for field, value in changes.items():
                item[field] = value
            for ref in add_ref or []:
                if ref not in item.setdefault("refs", []):
                    item["refs"].append(ref)
            for ref in remove_ref or []:
                if ref in item.get("refs", []):
                    item["refs"].remove(ref)
            work_edit = "next_action" in changes or "status" in changes
            if work_edit:
                item["last_check"] = datetime.now(timezone.utc).isoformat()
            self._validate_state(item)
            self._validate_tags(item)
            self._lift_window_to_minimum(item)
            self._warn_missing_refs(item.get("refs", []))
            self._save()
            if work_edit and item.get("check_after"):
                after = datetime.fromisoformat(item["check_after"])
                if after.tzinfo is None:
                    after = after.replace(tzinfo=timezone.utc)
                if after < datetime.now(timezone.utc):
                    print(
                        f"WARNING: check_after {after.date().isoformat()} je v minulosti",
                        file=sys.stderr,
                    )
            if "name" in changes and self.slugify(item["name"]) != item_id:
                print(f"TIP: use `cca-watchlist rename {item_id} NEW_ID` to update the ID", file=sys.stderr)
        return item

    def rename(self, old_id: str, new_id: str) -> dict[str, Any]:
        if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", new_id):
            die("NEW ID must be a nonempty canonical slug (lowercase letters, digits, hyphens)")
        with self._locked():
            item = self._find(old_id)
            if any(existing.get("id") == new_id for existing in self.data["items"]):
                die(f"item {new_id!r} already exists")
            item["id"] = new_id
            self._save()
        return item

    def remove_item(self, item_id: str) -> dict[str, Any]:
        with self._locked():
            item = self._find(item_id)
            self.data["items"] = [i for i in self.data["items"] if i.get("id") != item_id]
            self._save()
        return item

    def migrate(self) -> dict[str, Any]:
        """Upgrade a v1 file in place: enabled -> state, add v2 fields."""
        with self._locked():
            migrated = 0
            for item in self.data["items"]:
                if "state" not in item:
                    item["state"] = "active" if item.pop("enabled", True) else "done"
                    migrated += 1
                item.pop("enabled", None)
                item.setdefault("area", "")
                if item.get("type") != "note":
                    item.setdefault("blocked_on", "")
                    item.setdefault("next_action", "")
                refs = item.setdefault("refs", [])
                if item.get("file") and item["file"] not in refs:
                    refs.insert(0, item["file"])
                if item.get("type") != "note":
                    item.setdefault("once", False)
                    item.setdefault("effort", None)
                    item.setdefault("change_risk", None)
                    item.setdefault("window", None)
                item.setdefault("prio", None)
            self.data["version"] = SCHEMA_VERSION
            self._save()
        return {"migrated": migrated, "total": len(self.data["items"]), "version": SCHEMA_VERSION}


# ---------------------------------------------------------------- rendering


def format_items(items: list[dict[str, Any]]):
    """Detailed rendering, one block per item."""
    if not items:
        print("No items found")
        return

    for item in items:
        item_type = item.get("type", "unknown")
        print(f"[{item_type.upper()}] {item.get('name', 'unknown')}")
        print(f"  ID: {item.get('id')}")
        print(f"  State: {item.get('state')}   Area: {item.get('area') or '-'}")
        if item.get("description"):
            print(f"  Description: {item.get('description')}")
        if item_type == "incident":
            print(f"  Status: {item.get('status')}   Incident severity: {item.get('risk')}")
        if item_type == "note":
            print(f"  Priority: {item.get('prio')}")
            print(
                f"  Valid: {item.get('valid_from') or '*'} through {item.get('valid_until') or '*'}"
                " (local dates, inclusive)"
            )
            for ref in item.get("refs", []):
                print(f"  Ref: {ref}")
            if item.get("guide_keywords"):
                print(f"  Keywords: {item['guide_keywords']}")
            print()
            continue
        print(
            "  Effort: {}   Change risk: {}   Window: {}   Priority: {}".format(
                item.get("effort"),
                item.get("change_risk"),
                item.get("window"),
                item.get("prio"),
            )
        )
        if item.get("blocked_on"):
            print(f"  Blocked on: {item.get('blocked_on')}")
        if item.get("next_action"):
            print(f"  Next action: {item.get('next_action')}")
        for ref in item.get("refs", []):
            print(f"  Ref: {ref}")
        if item.get("guide_keywords"):
            print(f"  Keywords: {item.get('guide_keywords')}")
        print(f"  Last check: {item.get('last_check')}")
        if item.get("check_after"):
            print(f"  Check after: {item.get('check_after')}")
        if item.get("monitor_until"):
            print(f"  Monitor until: {item.get('monitor_until')}")
        print()


LIST_DISPLAY_LIMIT = 20


def format_list(items: list[dict[str, Any]], command: str):
    """Render one short line per item; show provides the full detail."""
    if not items:
        print("No items found")
        return

    # The daily check must see every due item, so list-today is never capped.
    limit = len(items) if command == "list-today" else LIST_DISPLAY_LIMIT
    for item in items[:limit]:
        if command == "list-today":
            fields = (item.get("id") or "-", item.get("prio") or "-",
                      item.get("effort") or "-", due_label(item))
        else:
            fields = (
                item.get("id") or "-",
                item.get("type") or "-",
                item.get("state") or "-",
                item.get("area") or "-",
                item.get("prio") or "-",
                item.get("name") or "-",
            )
        print(" | ".join(" ".join(str(value).split()) for value in fields))
    if len(items) > limit:
        hint = {
            "search": "Use a more specific search query",
            "list": "Narrow with list filters",
        }[command]
        print(f"Showing {LIST_DISPLAY_LIMIT} of {len(items)} items. {hint}; use show ID for details.")


def format_search(items: list[dict[str, Any]], brief: bool, closed_count: int | None = None):
    """Show one match in full, or a short ranked candidate list."""
    if not items:
        if closed_count is None:
            print("No items found")
        else:
            print(f"0 otevrenych; {closed_count} uzavrenych (--all)")
        return
    if len(items) == 1 and not brief:
        format_items(items)
        return
    if len(items) > LIST_DISPLAY_LIMIT:
        print(f"{len(items)} matches; first {LIST_DISPLAY_LIMIT}:")
    for item in items[:LIST_DISPLAY_LIMIT]:
        item_id = str(item.get("id") or "-")
        name = " ".join(str(item.get("name") or "").split())
        line = item_id if Watchlist.slugify(name) == item_id else f"{item_id} | {name}"
        if item.get("state") == "done":
            line += " [done]"
        print(line)
    if len(items) > LIST_DISPLAY_LIMIT:
        print("Use a more specific search query.")


def print_item_mutation(command: str, item: dict[str, Any], as_json: bool):
    if as_json:
        print(json.dumps(item, indent=2, ensure_ascii=False))
    else:
        print(f"{command}: {item['id']}")


def due_label(item: dict[str, Any]) -> str:
    """Show overdue days from UTC dates, regardless of the scheduled hour."""
    check_after = item.get("check_after")
    if not check_after:
        return "-"
    days = (datetime.now(timezone.utc).date() - datetime.fromisoformat(check_after).date()).days
    return "dnes" if days == 0 else f"+{days}d"


def format_agenda(today: list[dict[str, Any]], priority: list[dict[str, Any]]) -> None:
    shown_today = today[:LIST_DISPLAY_LIMIT]
    shown_priority = priority[:LIST_DISPLAY_LIMIT - len(shown_today)]
    for heading, items in (("Today", shown_today), ("Priority", shown_priority)):
        if items:
            print(f"{heading}:")
            for item in items:
                line = " | ".join((item.get("id") or "-", item.get("prio") or "-",
                                   item.get("effort") or "-", due_label(item)))
                if item.get("blocked_on"):
                    line += " [blocked]"
                print(line)
    hidden = len(today) + len(priority) - len(shown_today) - len(shown_priority)
    print(f"Hidden: {hidden}")


def format_ready(items: list[dict[str, Any]], untagged_count: int, verbose: bool = False):
    for item in items[:LIST_DISPLAY_LIMIT]:
        fields = (item.get("id") or "-", item.get("prio") or "-",
                  item.get("effort") or "-", Watchlist.effective_window(item) or "-")
        if verbose:
            fields += (item.get("next_action") or "-",)
        print(" | ".join(fields))
    print(f"Hidden: {max(0, len(items) - LIST_DISPLAY_LIMIT)}")
    print(f"Untagged (effort=null): {untagged_count}")


# -------------------------------------------------------------------- CLI


def add_common_item_args(sub, default_state: str):
    sub.add_argument("--area", default="", help="Area/grouping, e.g. a server or subsystem")
    sub.add_argument(
        "--state",
        choices=STATES,
        default=default_state,
        help=f"Item state (default: {default_state})",
    )
    sub.add_argument("--effort", choices=EFFORTS)
    sub.add_argument("--change-risk", dest="change_risk", choices=CHANGE_RISKS)
    sub.add_argument("--window", choices=WINDOWS)
    sub.add_argument("--prio", choices=PRIORITIES)
    sub.add_argument(
        "--refs", nargs="*", default=[], help="Paths to incident/guide with the full context"
    )
    sub.add_argument("--blocked-on", dest="blocked_on", default="", help="What this is waiting for")
    sub.add_argument("--next-action", dest="next_action", default="", help="The remaining step")
    sub.add_argument(
        "--check-after", dest="check_after", help="UTC date/time: YYYY-MM-DD[THH:MM[:SS][Z|±HH:MM]]; morning/afternoon also accepted"
    )
    sub.add_argument(
        "--monitor-until", dest="monitor_until", help='Monitor until: "X [week|day](s)"'
    )


def main():
    parser = argparse.ArgumentParser(
        description="Watchlist management (schema v2: daily checks + backlog in one register)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--debug", action="store_true", help="Enable debug mode")
    parser.add_argument(
        "--watchlist",
        help=(
            "Path to watchlist.json "
            "(default: $CCA_WATCHLIST, ./cca/watchlist.json, ./watchlist.json)"
        ),
    )

    parser.epilog = """
States:
  active  - part of the daily check (list-today)
  idle    - backlog: never in list-today, still found by search/list (work needs --refs)
  standby - wait for an event; excluded from list-today, ready and next
  done    - finished, hidden unless --all

Standby:
  standby ID waits for the event in description; next_action says what to capture.
  list --standby finds candidates; show ID displays trigger and capture details.
  blocked_on is an independent obstacle, not the trigger being awaited.
  list --all includes all states and types; explicit filters still apply.

Notes:
  idle information with optional refs and priority (default p2); never daily work.
  --valid-from / --valid-until are optional inclusive YYYY-MM-DD local dates.
  Missing boundaries are unlimited; no end means the note never expires.
  list --current / --expired select notes; done closes them explicitly.
  edit --valid-from '' / --valid-until '' removes the respective boundary.
  Work schedules (check_after) use UTC; offset inputs are converted to UTC.

Discovery:
  agenda shows due checks, then actionable p1 work, in at most 20 lines.
  Due age uses UTC dates: +Nd overdue, dnes due today, - no deadline.
  list-today shows every due item, one line each; list shows up to 20 items.
  ready text shows ID, priority, effort and effective window (20 rows);
  --verbose adds next_action. ready --json returns every candidate.
  search requires every word; ID/name/keywords rank above descriptions/actions.
  Use search --deep for refs, --brief for a single ID line, --all for done.
  One search match shows full details; larger sets show up to 20 IDs and names.
  Narrow broad results; --json keeps the complete machine-readable result.
  Item mutations confirm on one line; --json returns the full updated item.

Next:
  next returns one unblocked action fitting --time/--window/--max-change-risk.
  Order: p1, p2, p3, unset; then shorter effort; then ID. Defaults: 1h, wany.
  Missing effort/effective window, empty next_action and future check_after are excluded.
  JSON is one object or null. Selection does not change the register.

Examples:
  cca-watchlist agenda
  cca-watchlist list-today
  cca-watchlist list --area server1
  cca-watchlist list --state idle
  cca-watchlist add-note --name "Power maintenance" --description "Possible outage" \\
    --valid-from 2026-09-16 --valid-until 2026-09-17 --prio p1
  cca-watchlist list --current
  cca-watchlist list --expired
  cca-watchlist next --time 15m --json
  cca-watchlist show hetrix-status
  cca-watchlist search openresty
  cca-watchlist update hetrix-status

  cca-watchlist add-task \\
    --name "server1 web limits" \\
    --description "Deploy the reviewed anti-scan limits" \\
    --area server1 \\
    --refs incidents/2026-07-05-web-limits.md \\
    --blocked-on "user approval"

  cca-watchlist add-routine --name "Status check" --description "..." \\
    --keywords "status monitoring"
  cca-watchlist add-incident --name "server1 OOM" --file "incidents/x.md" --status monitoring

  cca-watchlist park server1-web-limits --blocked-on "user approval"
  cca-watchlist activate server2-delete-volume --check-after 2026-09-04T06:00:00Z
  cca-watchlist done old-task
  cca-watchlist edit server1-web-limits --area server1 --add-ref incidents/y.md
  cca-watchlist rename old-id new-id
  cca-watchlist migrate
    """

    subparsers = parser.add_subparsers(dest="command", help="Commands")

    p = subparsers.add_parser("list-today", help="List items to check today")
    p.add_argument("--type", choices=TYPES, help="Filter by type")
    p.add_argument("--json", action="store_true", help="Full JSON output")

    subparsers.add_parser("agenda", help="Due checks, then actionable p1 work (20 rows)")

    p = subparsers.add_parser("list", help="List items (one line per item)")
    p.add_argument("--area", help="Filter by area")
    state_filter = p.add_mutually_exclusive_group()
    state_filter.add_argument("--state", choices=STATES, help="Filter by state")
    state_filter.add_argument(
        "--standby", dest="state", action="store_const", const="standby",
        help="Select standby items (use show ID for trigger and evidence)",
    )
    p.add_argument("--type", choices=TYPES, help="Filter by type")
    p.add_argument("--effort", choices=EFFORTS, help="Filter by effort")
    p.add_argument("--change-risk", dest="change_risk", choices=CHANGE_RISKS)
    p.add_argument("--window", choices=WINDOWS, help="Filter by stored operational window")
    p.add_argument("--prio", choices=PRIORITIES, help="Filter by priority")
    p.add_argument("--max-change-risk", dest="max_change_risk", choices=CHANGE_RISKS)
    p.add_argument(
        "--all", action="store_true",
        help="Include all states and types (including standby and done); explicit filters still apply",
    )
    p.add_argument("--json", action="store_true", help="JSON output")
    validity = p.add_mutually_exclusive_group()
    validity.add_argument(
        "--expired", action="store_true", help="Notes ended before today (local date)"
    )
    validity.add_argument(
        "--current", action="store_true", help="Notes valid today (local date, inclusive)"
    )

    for command, help_text in (
        ("ready", "Select work for the available time and window"),
        ("next", "Select one action by priority, effort, then ID"),
    ):
        p = subparsers.add_parser(command, help=help_text)
        p.add_argument("--time", choices=("15m", "1h", "4h"), default="1h")
        p.add_argument("--window", choices=WINDOWS, default="wany")
        p.add_argument("--max-change-risk", dest="max_change_risk", choices=CHANGE_RISKS)
        p.add_argument("--area", help="Filter by area")
        if command == "ready":
            p.add_argument("--include-blocked", action="store_true")
            p.add_argument("--verbose", action="store_true", help="Include full next_action in text")
        p.add_argument("--json", action="store_true", help="JSON output")

    p = subparsers.add_parser("show", help="Show one item")
    p.add_argument("id", help="Item ID")
    p.add_argument("--json", action="store_true", help="JSON output")

    p = subparsers.add_parser("search", help="Find items by words in IDs, names and text")
    p.add_argument("query", help="Search query")
    p.add_argument("--all", action="store_true", help="Include done items")
    p.add_argument("--state", choices=STATES, help="Filter by state")
    p.add_argument("--deep", action="store_true", help="Also search reference paths")
    search_output = p.add_mutually_exclusive_group()
    search_output.add_argument("--brief", action="store_true", help="Only show the ID/name line")
    search_output.add_argument("--json", action="store_true", help="Full JSON matches")

    p = subparsers.add_parser("update", help="Update last_check timestamp")
    p.add_argument("id", help="Item ID")
    p.add_argument("--timestamp", help="ISO timestamp (default: NOW)")

    p = subparsers.add_parser("add-routine", help="Add routine check")
    p.add_argument("--name", required=True, help="Routine name")
    p.add_argument("--description", required=True, help="Job description")
    p.add_argument("--keywords", help="Guide keywords (optional, defaults to name.lower())")
    p.add_argument(
        "--once", action="store_true", help="One-time task (marked done after first check)"
    )
    add_common_item_args(p, default_state="active")

    p = subparsers.add_parser("add-note", help="Add searchable information, never work")
    p.add_argument("--name", required=True)
    p.add_argument("--description", required=True)
    p.add_argument("--valid-from", help="First valid local date, YYYY-MM-DD (inclusive)")
    p.add_argument("--valid-until", help="Last valid local date, YYYY-MM-DD (inclusive)")
    p.add_argument("--area", default="")
    p.add_argument("--refs", nargs="*", default=[])
    p.add_argument("--keywords")
    p.add_argument("--prio", choices=PRIORITIES, default="p2")

    p = subparsers.add_parser("add-task", help="Add a task / backlog item")
    p.add_argument("--name", required=True, help="Task name")
    p.add_argument("--description", required=True, help="Job description")
    p.add_argument("--keywords", help="Guide keywords (optional, defaults to name.lower())")
    add_common_item_args(p, default_state="idle")

    p = subparsers.add_parser("add-incident", help="Add incident")
    p.add_argument("--name", required=True, help="Incident name")
    p.add_argument("--file", required=True, help="Incident file path")
    p.add_argument("--status", required=True, help="Status (monitoring/blocked/resolved)")
    p.add_argument("--risk", default="MEDIUM", help="Risk level (default: MEDIUM)")
    p.add_argument("--description", default="", help="Job description (optional)")
    p.add_argument("--keywords", help="Guide keywords (optional, defaults to name.lower())")
    add_common_item_args(p, default_state="active")

    p = subparsers.add_parser("edit", help="Edit fields of an existing item")
    p.add_argument("id", help="Item ID")
    p.add_argument("--valid-from", help="Note start date; empty string removes boundary")
    p.add_argument("--valid-until", help="Note end date; empty string removes boundary")
    p.add_argument("--name")
    p.add_argument("--description")
    p.add_argument("--area")
    p.add_argument("--keywords", dest="guide_keywords")
    p.add_argument("--blocked-on", dest="blocked_on")
    p.add_argument("--next-action", dest="next_action")
    p.add_argument("--status")
    p.add_argument("--risk")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("--change-risk", dest="change_risk", choices=CHANGE_RISKS)
    p.add_argument("--window", choices=WINDOWS)
    p.add_argument("--prio", choices=PRIORITIES)
    p.add_argument("--file")
    p.add_argument("--state", choices=STATES)
    p.add_argument("--refs", nargs="*", help="Replace the whole refs list")
    p.add_argument("--add-ref", dest="add_ref", nargs="*", default=[], help="Append refs")
    p.add_argument("--remove-ref", dest="remove_ref", nargs="*", default=[], help="Drop refs")
    p.add_argument("--check-after", dest="check_after", help="UTC: YYYY-MM-DD[THH:MM[:SS][Z|±HH:MM]]; empty clears")
    p.add_argument("--monitor-until", dest="monitor_until", help='"X [week|day](s)"; empty clears')

    p = subparsers.add_parser("rename", help="Change an item ID without changing other fields")
    p.add_argument("old", help="Current ID")
    p.add_argument("new", help="New canonical slug ID")

    p = subparsers.add_parser("park", help="Move item to backlog (state=idle)")
    p.add_argument("id", help="Item ID")
    p.add_argument("--blocked-on", dest="blocked_on", help="What this is waiting for")

    p = subparsers.add_parser("activate", help="Move item into the daily check (state=active)")
    p.add_argument("id", help="Item ID")
    p.add_argument("--check-after", dest="check_after", help="UTC: YYYY-MM-DD[THH:MM[:SS][Z|±HH:MM]]")

    p = subparsers.add_parser("standby", help="Wait for the event in description (state=standby)")
    p.add_argument("id", help="Item ID; next_action describes what to capture")

    p = subparsers.add_parser("done", help="Mark item finished (state=done)")
    p.add_argument("id", help="Item ID")

    p = subparsers.add_parser("remove", help="Remove item by ID")
    p.add_argument("id", help="Item ID")

    subparsers.add_parser("migrate", help="Upgrade a v1 watchlist.json to v2 in place")

    for command in ITEM_MUTATION_COMMANDS:
        subparsers.choices[command].add_argument("--json", action="store_true", help="Full JSON item")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    debug = getattr(args, "debug", False)
    filepath = resolve_watchlist_path(getattr(args, "watchlist", None))
    if not filepath.exists() and args.command not in CREATING_COMMANDS:
        die(
            f"watchlist not found: {filepath}\n"
            "Run this from the project root, or set $CCA_WATCHLIST / --watchlist. "
            "An empty result would look like 'nothing to check today'."
        )

    watchlist = Watchlist(filepath, debug=debug, allow_legacy=(args.command == "migrate"))

    if args.command == "list-today":
        items = watchlist.list_today(item_type=args.type)
        if args.json:
            print(json.dumps(items, indent=2, ensure_ascii=False))
        else:
            format_list(items, "list-today")

    elif args.command == "agenda":
        format_agenda(*watchlist.agenda())

    elif args.command == "list":
        if (args.expired or args.current) and args.type not in (None, "note"):
            parser.error("--expired and --current only apply to --type note")
        items = watchlist.list_items(
            area=args.area,
            state=args.state,
            item_type=args.type,
            include_done=args.all,
            effort=args.effort,
            change_risk=args.change_risk,
            window=args.window,
            prio=args.prio,
            max_change_risk=args.max_change_risk,
            expired=args.expired,
            current=args.current,
        )
        if args.json:
            print(json.dumps(items, indent=2, ensure_ascii=False))
        else:
            format_list(items, "list")

    elif args.command == "next":
        item = watchlist.next_item(
            time_box={"15m": "e15", "1h": "e1h", "4h": "e4h"}[args.time],
            window=args.window,
            max_change_risk=args.max_change_risk,
            area=args.area,
        )
        if args.json:
            print(
                json.dumps(
                    dict(item, effective_window=watchlist.effective_window(item)) if item else None,
                    indent=2,
                    ensure_ascii=False,
                )
            )
        elif item:
            format_items([item])
        else:
            print("No actionable items found")

    elif args.command == "ready":
        time_box = {"15m": "e15", "1h": "e1h", "4h": "e4h"}[args.time]
        items, untagged = watchlist.ready_items(
            time_box=time_box,
            window=args.window,
            max_change_risk=args.max_change_risk,
            area=args.area,
            include_blocked=args.include_blocked,
        )
        if args.json:
            ready = [
                dict(item, effective_window=watchlist.effective_window(item)) for item in items
            ]
            print(json.dumps({"ready": ready, "untagged": untagged}, indent=2, ensure_ascii=False))
        else:
            format_ready(items, len(untagged), verbose=args.verbose)

    elif args.command == "show":
        item = watchlist._find(args.id)
        if args.json:
            print(json.dumps(item, indent=2, ensure_ascii=False))
        else:
            format_items([item])

    elif args.command == "search":
        items = watchlist.search(
            args.query, include_done=args.all, state=args.state, deep=args.deep
        )
        if args.json:
            print(json.dumps(items, indent=2, ensure_ascii=False))
        else:
            closed_count = None
            if not args.all and not args.state and not items:
                closed_count = len(watchlist.search(args.query, state="done", deep=args.deep))
            format_search(items, args.brief, closed_count)

    elif args.command == "update":
        item = watchlist.update_timestamp(args.id, timestamp=args.timestamp)
        print_item_mutation(args.command, item, args.json)

    elif args.command == "add-routine":
        item = watchlist.add_routine(
            name=args.name,
            description=args.description,
            keywords=args.keywords,
            area=args.area,
            state=args.state,
            refs=args.refs,
            blocked_on=args.blocked_on,
            next_action=args.next_action,
            check_after=args.check_after,
            monitor_until=args.monitor_until,
            once=args.once,
            effort=args.effort,
            change_risk=args.change_risk,
            window=args.window,
            prio=args.prio,
        )
        print_item_mutation(args.command, item, args.json)

    elif args.command == "add-note":
        item = watchlist.add_note(
            name=args.name,
            description=args.description,
            valid_from=args.valid_from,
            valid_until=args.valid_until,
            area=args.area,
            refs=args.refs,
            keywords=args.keywords,
            prio=args.prio,
        )
        print_item_mutation(args.command, item, args.json)

    elif args.command == "add-task":
        item = watchlist.add_task(
            name=args.name,
            description=args.description,
            area=args.area,
            state=args.state,
            refs=args.refs,
            blocked_on=args.blocked_on,
            next_action=args.next_action,
            keywords=args.keywords,
            check_after=args.check_after,
            monitor_until=args.monitor_until,
            effort=args.effort,
            change_risk=args.change_risk,
            window=args.window,
            prio=args.prio,
        )
        print_item_mutation(args.command, item, args.json)

    elif args.command == "add-incident":
        item = watchlist.add_incident(
            name=args.name,
            file=args.file,
            status=args.status,
            risk=args.risk,
            description=args.description,
            area=args.area,
            state=args.state,
            refs=args.refs,
            blocked_on=args.blocked_on,
            next_action=args.next_action or "Monitor",
            keywords=args.keywords,
            check_after=args.check_after,
            monitor_until=args.monitor_until,
            effort=args.effort,
            change_risk=args.change_risk,
            window=args.window,
            prio=args.prio,
        )
        print_item_mutation(args.command, item, args.json)

    elif args.command == "edit":
        changes: dict[str, Any] = {}
        for field in (
            "name",
            "description",
            "area",
            "guide_keywords",
            "blocked_on",
            "next_action",
            "status",
            "risk",
            "effort",
            "change_risk",
            "window",
            "prio",
            "file",
            "state",
        ):
            value = getattr(args, field, None)
            if value is not None:
                changes[field] = value
        if args.refs is not None:
            changes["refs"] = args.refs
        for field in ("valid_from", "valid_until"):
            value = getattr(args, field)
            if value is not None:
                changes[field] = value or None
        check_after_iso, monitor_until_iso = watchlist._parse_schedule(
            args.check_after, args.monitor_until
        )
        if args.check_after is not None:
            changes["check_after"] = check_after_iso
        if args.monitor_until is not None:
            changes["monitor_until"] = monitor_until_iso
        item = watchlist.edit(args.id, changes, add_ref=args.add_ref, remove_ref=args.remove_ref)
        print_item_mutation(args.command, item, args.json)

    elif args.command == "rename":
        item = watchlist.rename(args.old, args.new)
        print_item_mutation(args.command, item, args.json)

    elif args.command == "park":
        item = watchlist.set_state(args.id, "idle", blocked_on=args.blocked_on)
        print_item_mutation(args.command, item, args.json)

    elif args.command == "activate":
        item = watchlist.set_state(args.id, "active", check_after=args.check_after)
        print_item_mutation(args.command, item, args.json)

    elif args.command in ("standby", "done"):
        item = watchlist.set_state(args.id, args.command)
        print_item_mutation(args.command, item, args.json)

    elif args.command == "remove":
        item = watchlist.remove_item(args.id)
        print(json.dumps({"removed": item}, indent=2, ensure_ascii=False))

    elif args.command == "migrate":
        print(json.dumps(watchlist.migrate(), indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
